QMainWindow::separator { background: @chrome; width: 4px; height: 4px; }
QToolBar { border: none; spacing: 2px; background: @window; }
QToolBar#statusLine, QToolBar#shelf { padding: 1px; }
QToolBar#toolbox { background: @chrome; }
QMenuBar { background: @window; }
QMenuBar::item { padding: 3px 8px; background: transparent; }
QMenuBar::item:selected { background: @hi; }
QMenuBar#panelMenus { background: @chrome; font-size: 8pt; }
QMenuBar#panelMenus::item { padding: 1px 6px; }
QToolBar#panelBar { background: @chrome; }
QMenu { background: @menu; border: 1px solid @border; }
QMenu::item { padding: 3px 24px 3px 26px; }
QMenu::item:selected { background: @hi; }
QMenu::item:disabled { color: @disabled; }
QMenu::separator { height: 1px; background: @chrome; margin: 3px 6px; }
QLabel#menuShortcut { color: @dim; }
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background: @chrome; padding: 3px 6px; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: @chrome; padding: 3px 10px; border: 1px solid @border; border-bottom: none; }
QTabBar::tab:selected { background: @button; }
QTabWidget#shelfTabs QTabBar::tab { padding: 1px 8px; font-size: 8pt; }
QPushButton#feelButton { background: #ff8a00; color: #101010; font-weight: bold; font-size: 16px; border: 1px solid #ffc27a; border-radius: 3px; padding: 10px 18px; border-radius: 4px; }
QPushButton#feelButton:hover { background: #ffa533; }
QPushButton#feelButton:pressed { background: #e07400; }
QToolButton#feelFold { border: none; background: transparent; color: @text; font-size: 14px; padding: 0; }
QToolButton#feelFold:hover { background: @hover; border-radius: 3px; }
QLabel#feedbackWarning { background: #b00020; color: #ffffff; font-weight: bold; padding: 6px; border-radius: 3px; }
QPushButton#feedbackSubmit { font-weight: bold; padding: 3px 12px; }
QFrame#feedbackCard { border: 1px solid @border; border-radius: 4px; }
QLabel#feedbackHint { color: @dim; }
QToolButton#feedbackThumb { border: 1px solid @border; border-radius: 3px; background: @chrome; }
QToolButton#feedbackThumb:hover { border-color: @hi; }
QToolButton#feedbackSuggest { border: 1px dashed @dim; border-radius: 3px; background: transparent; }
QToolButton#feedbackSuggest:hover { border-color: @hi; }
QToolButton#feedbackThumbRemove { border: none; border-radius: 10px; background: rgba(0, 0, 0, 160); color: #ffffff; font-weight: bold; }
QToolButton#feedbackThumbRemove:hover { background: #b00020; }
QPushButton#feedbackRecord { font-weight: bold; padding: 3px 12px; }
QToolButton#feedbackShowPreview { border: none; color: @dim; }
QLineEdit { background: @base; border: 1px solid @border; padding: 1px 3px; selection-background-color: @hi; }
QLineEdit:read-only { background: @alt; }
QLineEdit#channelValue { background: @base; border: none; }
QLineEdit#channelConnected { background: #f1f1a5; color: #1e1e1e; border: none; }
QLineEdit#channelKeyed { background: #dd727a; color: #1e1e1e; border: none; }
QLineEdit#channelKeyOnFrame { background: #cd2729; color: #f0f0f0; border: none; }
QLineEdit#channelChanged { background: #e3ac79; color: #1e1e1e; border: none; }
QLineEdit#channelLayered { background: #d9c36a; color: #1e1e1e; border: none; }
QLineEdit#channelMuted { background: #8a6a48; color: #1e1e1e; border: none; }
QLineEdit#channelLocked { background: #5c6874; color: #e6eaee; border: none; }
QLineEdit#channelHeader { background: transparent; border: none; font-weight: bold; }
QLabel#channelName { color: @text; padding-right: 2px; }
QLabel#channelEmpty { color: @dim; padding: 12px; }
QLabel#channelName[picked="true"] { background: @hi; color: #ffffff; }
QLineEdit#channelValue[picked="true"], QLineEdit#channelKeyed[picked="true"], QLineEdit#channelKeyOnFrame[picked="true"], QLineEdit#channelChanged[picked="true"], QLineEdit#channelLayered[picked="true"], QLineEdit#channelMuted[picked="true"], QLineEdit#channelLocked[picked="true"], QLineEdit#channelConnected[picked="true"] { background: @hi; color: #ffffff; border: none; selection-background-color: #ffffff; selection-color: @hi; }
QLabel#channelSection { color: @dim; font-weight: bold; padding-top: 4px; }
QLabel#channelNode { color: @bright; background: #3a3a3a; padding: 2px 6px; }
QPushButton#channelNodeButton { text-align: left; padding: 2px 6px; color: @bright; border: none; background: #3a3a3a; }
QPushButton#channelNodeButton:hover { background: @hover; }
QLabel#aeSection { background: @button; padding: 3px 6px; font-weight: bold; }
QToolButton#aeSectionButton { background: @button; padding: 3px 6px; font-weight: bold; border: none; text-align: left; }
QFrame#inViewEditor { background: @chrome; border: 1px solid @border; }
QLineEdit#cmdResult { background: @alt; }
QLineEdit#cmdResult[error="true"] { background: #8a2f2f; color: white; }
QToolButton#cmdLang { min-width: 34px; }
QToolButton#hotboxButton { background: @menu; color: @text; padding: 4px 8px; border: 0; border-radius: 0; }
QToolButton#hotboxButton:hover { background: @hi; }
QToolButton#hotboxButton:disabled { color: @dim; }
QToolButton#hotboxButton::menu-indicator { image: none; width: 0; }
QLabel#hotboxCenter { background: @menu; color: @bright; padding: 7px 16px; }
QPlainTextEdit#scriptHistory { background: @base; }
QPlainTextEdit#scriptInput { background: @base; }
QTreeWidget#outliner { background: @base; alternate-background-color: @alt; }
QTreeView::item:selected { background: @hi; }
QStatusBar#helpLine { background: @chrome; }
QLabel#optionsDoc { color: @dim; padding: 4px; }
QScrollBar:vertical { background: @chrome; width: 12px; }
QScrollBar::handle:vertical { background: @handle; min-height: 20px; }
QScrollBar:horizontal { background: @chrome; height: 12px; }
QScrollBar::handle:horizontal { background: @handle; min-width: 20px; }
QLabel#menuSection { color: @dim; font-style: italic; padding: 1px 0; }
QToolButton#shelfSide { color: @dim; font-size: 13px; padding: 0 2px; min-width: 14px; border: none; }
QToolButton#shelfSide:hover { background: @hover; border-radius: 2px; }
QLabel#toolboxMark { padding: 6px 0 4px 0; }
QMainWindow > QTabBar::tab { background: @chrome; color: @dim; padding: 6px 3px; border: 1px solid @border; }
QMainWindow > QTabBar::tab:selected { background: @menu; color: @bright; }

/* A field something else drives: the reference's yellow. */
QLineEdit#connectedField { background: #f1f1a5; color: #101010; }
QLineEdit#keyedField { background: #dd727a; color: #1e1e1e; }
/* A locked attribute: shown dimmed, and it takes no typing (#212). */
QLineEdit#lockedField { background: @button; color: @dim; }
QToolBar#playback QToolButton:checked { background: @hi; border-radius: 3px; }
QToolButton#mapButton { border: none; padding: 0; }
QToolButton#mapButton:hover { background: @button; }
/* The status line's group handles: a raised bar, an arrow when the group is folded. */
QToolButton#statusHandle { border: none; border-left: 1px solid @border; border-right: 1px solid @hover; background: @chrome; margin: 2px 2px; padding: 0; color: @dim; font-size: 9px; }
QToolButton#statusHandle:hover { background: @hi; }
QToolButton#statusHandle:checked { background: @chrome; }

/* The Attribute Editor's chrome, to the reference's own measurements. */
QMenu#aeMenu { background: @menu; border: 1px solid @border; padding: 2px 0; }
QMenu#aeMenu::item { padding: 1px 20px 1px 22px; font-size: 11px; color: @text; }
QMenu#aeMenu::item:selected { background: @hi; color: @hitext; }
QMenu#aeMenu::item:disabled { color: @disabled; }
QMenu#aeMenu::separator { height: 1px; background: @chrome; margin: 3px 4px; }
QWidget#aeMenuBar { background: @window; border: none; }
QWidget#aeMenuBar QToolButton#aeMenuItem { background: transparent; border: none; padding: 4px 8px; font-size: 11px; color: @text; }
QWidget#aeMenuBar QToolButton#aeMenuItem:hover { background: @hi; color: @hitext; }
QWidget#aeMenuBar QToolButton#aeMenuItem::menu-indicator { image: none; width: 0; }
QToolButton#aePin { background: transparent; border: none; color: @text; font-size: 13px; padding: 0 4px; }
QToolButton#aePin:hover { background: @hover; }
QToolButton#aePin:checked { color: @bright; }
QTabWidget#aeTabs::pane { border: none; background: @window; top: 0px; }
QTabWidget#aeTabs QTabBar { background: @window; }
QTabWidget#aeTabs QTabBar::tab { background: @alt; color: @text; border: 1px solid @border; border-bottom: none; padding: 3px 6px; margin-right: 1px; font-size: 11px; min-height: 16px; }
QTabWidget#aeTabs QTabBar::tab:selected { background: @button; color: @bright; }
QTabWidget#aeTabs QTabBar::tab:hover { background: @hover; }
QWidget#aePage { background: @window; }
QLabel#aeTypeLabel { font-size: 11px; color: @text; }
QLabel#aeRowLabel { font-size: 11px; color: @text; }
QLabel#aeDimLabel { font-size: 11px; color: @disabled; }
QPushButton#aeSmallButton, QToolButton#aeSmallButton { background: @button; border: 1px solid @border; color: @text; font-size: 11px; padding: 0 4px; }
QPushButton#aeSmallButton:hover, QToolButton#aeSmallButton:hover { background: @hover; }
QPushButton#aeSmallButton:pressed, QToolButton#aeSmallButton:pressed { background: @chrome; }
QToolButton#aeSmallButton::menu-indicator { image: none; width: 0; }
QToolButton#aeLinkButton { border: none; background: transparent; }
QPushButton#aeBottomButton { background: @button; border: 1px solid @border; color: @text; font-size: 11px; padding: 2px 4px; }
QPushButton#aeBottomButton:hover { background: @hover; }
QToolButton#aeArrowButton { background: @button; border: 1px solid @border; color: @text; font-size: 10px; padding: 0; }
QWidget#aeNotesArea { background: @window; }
QFrame#aeDottedLine { border: none; border-top: 1px dotted @dim; max-height: 1px; }
QLabel#aeNotesLabel { font-size: 11px; font-weight: bold; color: @bright; }
QPlainTextEdit#aeNotes { background: @base; border: 1px solid @border; color: @text; font-size: 11px; }
QWidget#aePage QComboBox { background: @button; border: 1px solid @border; color: @text; font-size: 11px; padding: 1px 4px; }
QWidget#aePage QCheckBox { font-size: 11px; }
QWidget#aePage QLabel { font-size: 11px; }
QPushButton#aeTinyButton { background: @button; border: 1px solid @border; color: @text; font-size: 10px; padding: 0; }
QPushButton#aeTinyButton:hover { background: @hover; }
QWidget#aePage QComboBox:disabled { background: @alt; color: @disabled; border: 1px solid @border; }
QWidget#aePage QCheckBox:disabled { color: @disabled; }
QTabWidget#aeTabs QTabBar::tab:first { margin-left: 10px; }
QWidget#aePage QSlider::groove:horizontal { background: @handle; height: 4px; border: none; }
QWidget#aePage QSlider::sub-page:horizontal { background: @handle; height: 4px; }
QWidget#aePage QSlider::handle:horizontal { background: @text; width: 7px; margin: -4px 0; border: 1px solid @border; }
QLabel#aeEmpty { color: @text; font-size: 11px; background: @window; }
QTableWidget#aeInputTable { background: @base; gridline-color: @chrome; color: @text; font-size: 11px; border: 1px solid @border; }
QTableWidget#aeInputTable QHeaderView::section { background: @alt; color: @bright; border: 1px solid @border; padding: 1px 4px; font-size: 11px; }
QToolButton#aeManageGeometry { background: transparent; border: none; color: @text; font-size: 11px; }
QToolButton#aeManageGeometry:hover { color: @bright; }
QToolButton#aeManageGeometry::menu-indicator { image: none; width: 0; }

/* The Attribute Editor's fields wear the Channel Box's field colours and selection. */
QLineEdit#aeField { background: @base; border: none; color: @text; font-size: 11px; padding: 0 3px; selection-background-color: @hi; selection-color: @hitext; }
QLineEdit#aeField:read-only { background: @alt; color: @dim; }
QLineEdit#aeField:disabled { background: @chrome; color: @disabled; }
QLineEdit#aeField[connected="true"] { background: #f1f1a5; color: #101010; }
QLineEdit#aeField[keyed="true"] { background: #dd727a; color: #1e1e1e; }
QLineEdit#aeField[locked="true"] { background: @button; color: @dim; }
QWidget#aeSectionBody { background: @alt; }
QWidget#aeSectionHead { background: @section; color: @sectiontext; border-top: 1px solid @light; border-bottom: 1px solid @shadow; }
QWidget#aeSectionHead:hover { border-top-color: @hi; }
QFrame#aeRowLine { background: @chrome; border: none; }
