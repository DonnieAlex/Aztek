QMainWindow::separator { background: @chrome; width: 4px; height: 4px; }
QToolBar { border: none; spacing: 2px; background: @window; }
QToolBar#statusLine, QToolBar#shelf { padding: 1px; }
QToolBar#toolbox { background: @chrome; }
QMenuBar { background: @window; }
QMenuBar::item { padding: 3px 8px; background: transparent; }
QMenuBar::item:selected { background: @hi; }
QMenuBar#panelMenus { background: @chrome; font-size: 8pt; }
QMenuBar#panelMenus::item { padding: 1px 6px; }
QToolBar#panelBar { background: @chrome; }
QMenu { background: @menu; border: 1px solid @border; }
QMenu::item { padding: 3px 24px 3px 26px; }
QMenu::item:selected { background: @hi; }
QMenu::item:disabled { color: @disabled; }
QMenu::separator { height: 1px; background: @chrome; margin: 3px 6px; }
QLabel#menuShortcut { color: @dim; }
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background: @chrome; padding: 3px 6px; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: @chrome; padding: 3px 10px; border: 1px solid @border; border-bottom: none; }
QTabBar::tab:selected { background: @button; }
QTabWidget#shelfTabs QTabBar::tab { padding: 1px 8px; font-size: 8pt; }
QPushButton#feelButton { background: #ff8a00; color: #101010; font-weight: bold; font-size: 16px; border: 1px solid #ffc27a; border-radius: 3px; padding: 10px 18px; border-radius: 4px; }
QPushButton#feelButton:hover { background: #ffa533; }
QPushButton#feelButton:pressed { background: #e07400; }
QToolButton#feelFold { border: none; background: transparent; color: @text; font-size: 14px; padding: 0; }
QToolButton#feelFold:hover { background: @hover; border-radius: 3px; }
QLabel#feedbackWarning { background: #b00020; color: #ffffff; font-weight: bold; padding: 6px; border-radius: 3px; }
QPushButton#feedbackSubmit { font-weight: bold; padding: 3px 12px; }
QLineEdit { background: @base; border: 1px solid @border; padding: 1px 3px; selection-background-color: @hi; }
QLineEdit:read-only { background: @alt; }
QLineEdit#channelValue { background: @base; border: none; }
QLineEdit#channelConnected { background: #f1f1a5; color: #1e1e1e; border: none; }
QLineEdit#channelKeyed { background: #dd727a; color: #1e1e1e; border: none; }
QLineEdit#channelKeyOnFrame { background: #cd2729; color: #f0f0f0; border: none; }
QLineEdit#channelChanged { background: #e3ac79; color: #1e1e1e; border: none; }
QLineEdit#channelLayered { background: #d9c36a; color: #1e1e1e; border: none; }
QLineEdit#channelMuted { background: #8a6a48; color: #1e1e1e; border: none; }
QLineEdit#channelLocked { background: #5c6874; color: #e6eaee; border: none; }
QLineEdit#channelHeader { background: transparent; border: none; font-weight: bold; }
QLabel#channelName { color: @text; padding-right: 2px; }
QLabel#channelName[picked="true"] { background: @hi; color: #ffffff; }
QLineEdit#channelValue[picked="true"], QLineEdit#channelKeyed[picked="true"], QLineEdit#channelKeyOnFrame[picked="true"], QLineEdit#channelChanged[picked="true"], QLineEdit#channelLayered[picked="true"], QLineEdit#channelMuted[picked="true"], QLineEdit#channelLocked[picked="true"], QLineEdit#channelConnected[picked="true"] { background: @hi; color: #ffffff; border: none; selection-background-color: #ffffff; selection-color: @hi; }
QLabel#channelSection { color: @dim; font-weight: bold; padding-top: 4px; }
QLabel#channelNode { color: @bright; padding-left: 6px; }
QPushButton#channelNodeButton { text-align: left; padding: 2px 6px; color: @bright; border: none; }
QPushButton#channelNodeButton:hover { background: @hover; }
QLabel#aeSection { background: @button; padding: 3px 6px; font-weight: bold; }
QToolButton#aeSectionButton { background: @button; padding: 3px 6px; font-weight: bold; border: none; text-align: left; }
QFrame#inViewEditor { background: @chrome; border: 1px solid @border; }
QLineEdit#cmdResult { background: @alt; }
QLineEdit#cmdResult[error="true"] { background: #8a2f2f; color: white; }
QToolButton#cmdLang { min-width: 34px; }
QToolButton#hotboxButton { background: @menu; padding: 5px 10px; border: 1px solid @border; }
QToolButton#hotboxButton:hover { background: @hi; }
QLabel#hotboxCenter { background: @chrome; color: @bright; border: 1px solid @border; padding: 4px 10px; }
QPlainTextEdit#scriptHistory { background: @base; }
QPlainTextEdit#scriptInput { background: @base; }
QTreeWidget#outliner { background: @base; alternate-background-color: @alt; }
QTreeView::item:selected { background: @hi; }
QStatusBar#helpLine { background: @chrome; }
QLabel#optionsDoc { color: @dim; padding: 4px; }
QScrollBar:vertical { background: @chrome; width: 12px; }
QScrollBar::handle:vertical { background: @handle; min-height: 20px; }
QScrollBar:horizontal { background: @chrome; height: 12px; }
QScrollBar::handle:horizontal { background: @handle; min-width: 20px; }
QLabel#menuSection { color: @dim; font-style: italic; padding: 1px 0; }
QToolButton#shelfSide { color: @dim; font-size: 13px; padding: 0 2px; min-width: 14px; border: none; }
QToolButton#shelfSide:hover { background: @hover; border-radius: 2px; }
QLabel#toolboxMark { padding: 6px 0 4px 0; }
QMainWindow > QTabBar::tab { background: @chrome; color: @dim; padding: 6px 3px; border: 1px solid @border; }
QMainWindow > QTabBar::tab:selected { background: @menu; color: @bright; }

/* A field something else drives: the reference's yellow. */
QLineEdit#connectedField { background: #f1f1a5; color: #101010; }
QLineEdit#keyedField { background: #dd727a; color: #1e1e1e; }
/* A locked attribute: shown dimmed, and it takes no typing (#212). */
QLineEdit#lockedField { background: @button; color: @dim; }
QToolBar#playback QToolButton:checked { background: @hi; border-radius: 3px; }
QToolButton#mapButton { border: none; padding: 0; }
QToolButton#mapButton:hover { background: @button; }
/* The status line's group handles: a raised bar, an arrow when the group is folded. */
QToolButton#statusHandle { border: none; border-left: 1px solid @border; border-right: 1px solid @hover; background: @chrome; margin: 2px 2px; padding: 0; color: @dim; font-size: 9px; }
QToolButton#statusHandle:hover { background: @hi; }
QToolButton#statusHandle:checked { background: @chrome; }
