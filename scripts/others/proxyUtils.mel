// proxyUtils: helpers for reference proxies. The references that stand in for one another are each linked through
// their proxyMsg plug to the proxyList of one proxyManager node; the manager's activeProxy points at the entry of the
// one in use.

// A manager's tag: its name without the "PM" ending, when it has one and something before it ("PM" alone stays).
global proc string proxyManagerTag(string $proxyManager)
{
    int $length = size($proxyManager);
    if ($length > 2 && endsWith($proxyManager, "PM"))
        return substring($proxyManager, 1, $length - 2);
    return $proxyManager;
}

// The node part of a plug ("node.attr[0]" gives "node").
proc string proxyPlugNode(string $plug)
{
    return `match "^[^.]*" $plug`;
}

// The proxy manager a reference node belongs to, or "".
global proc string proxyManager(string $refNode)
{
    string $source = `connectionInfo -sourceFromDestination ($refNode + ".proxyMsg")`;
    if ($source == "")
        return "";
    return proxyPlugNode($source);
}

// Whether a reference node is the proxy in use. activeProxy leads to the manager's list entry, not to the reference,
// so the entry the reference feeds is what's compared.
global proc int isActiveProxy(string $refNode)
{
    string $source = `connectionInfo -sourceFromDestination ($refNode + ".proxyMsg")`;
    if ($source == "")
        return 0;
    string $manager = proxyPlugNode($source);
    if ($manager == "")
        return 0;
    string $active[] = `connectionInfo -destinationFromSource ($manager + ".activeProxy")`;
    return size($active) > 0 && $active[0] == $source;
}

global proc int isValidReference(string $nodeName)
{
    if ($nodeName == "" || !`objExists $nodeName`)
        return 0;
    return `objectType $nodeName` == "reference";
}

// Whether one of the manager's references already goes by $tag.
global proc int usedTag(string $proxyManager, string $tag)
{
    if (`objectType $proxyManager` != "proxyManager")
        return 0;
    string $refs[] = `listConnections -type reference ($proxyManager + ".proxyList")`;
    for ($ref in $refs) {
        string $refTag = `getAttr ($ref + ".proxyTag")`;
        if ($refTag == $tag)
            return 1;
    }
    return 0;
}

// The last part of a name with namespaces ("A:B:C" gives "C").
global proc string shortNameProxy(string $proxyName)
{
    string $parts[];
    int $count = `tokenize $proxyName ":" $parts`;
    return $parts[$count - 1];
}

// The manager's short name followed by the lowest number no reference of it goes by yet. The "PM" ending is kept.
global proc string uniqueTag(string $proxyManager)
{
    string $base = shortNameProxy($proxyManager);
    int $i = 1;
    while (usedTag($proxyManager, $base + $i))
        $i++;
    return $base + $i;
}
