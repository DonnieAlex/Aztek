// performUnparent: Edit > Unparent, as the reference's, its settings kept in optionVars. $action 0 unparents the
// selection and returns the command, 1 opens the option box, 2 only returns the command; anything else returns "".

proc performUnparent_options(int $force)
{
    if ($force || !`optionVar -ex unparentRemove`)
        optionVar -iv unparentRemove 0;
    if ($force || !`optionVar -ex unparentPreserve`)
        optionVar -iv unparentPreserve 1;
}

// Aztek has no shared option box frame yet, so the box is a small window of its own: the controls in a scrolling
// column, then Apply, Save, Reset and Close.
proc string performUnparent_boxBegin(string $win, string $title)
{
    if (`window -ex $win`)
        deleteUI -window $win;
    window -t $title $win;
    columnLayout -adj true boxFrame;
    scrollLayout -cr true;
    return `columnLayout -adj true`;
}

proc performUnparent_boxEnd(string $win, string $applyLabel, string $apply, string $save, string $reset)
{
    setParent ($win + "|boxFrame");
    rowLayout -nc 4;
    button -l $applyLabel -c $apply;
    button -l "Save" -c ($save + "; deleteUI -window " + $win + ";");
    button -l "Reset" -c $reset;
    button -l "Close" -c ("deleteUI -window " + $win);
    showWindow $win;
}

global proc string performUnparent(int $action)
{
    if ($action == 1) {
        string $win = "performUnparentOptionBox";
        string $parent = performUnparent_boxBegin($win, "Unparent Options");
        int $template = `uiTemplate -ex DefaultTemplate`;
        if ($template)
            setUITemplate -pst DefaultTemplate;
        waitCursor -st 1;
        // Preserve position greys out while removing the instance is chosen.
        string $check = $parent + "|unparentCheck";
        radioButtonGrp -nrb 2 -l "Unparent method:" -la2 "Parent to world" "Remove instance"
            -on2 ("checkBoxGrp -e -en1 false " + $check) -of2 ("checkBoxGrp -e -en1 true " + $check) unparentMethod;
        checkBoxGrp -ncb 1 -l1 "Preserve position" unparentCheck;
        waitCursor -st 0;
        if ($template)
            setUITemplate -ppt;
        performUnparent_boxEnd($win, "Unparent", "unparentCallback " + $parent + " 1", "unparentCallback " + $parent + " 0",
            "unparentSetup " + $parent + " 1");
        unparentSetup $parent 0;
        return "";
    }
    if ($action != 0 && $action != 2)
        return "";

    performUnparent_options(0);
    // On the selection: to the world, or the instance taken away; -r drops the world position.
    string $cmd = "parent";
    $cmd += `optionVar -q unparentRemove` ? " -rm" : " -w";
    if (!`optionVar -q unparentPreserve`)
        $cmd += " -r";
    if ($action == 0)
        evalEcho $cmd;
    return $cmd;
}

global proc unparentSetup(string $parent, int $forceFactorySettings)
{
    performUnparent_options($forceFactorySettings);
    setParent $parent;
    int $remove = `optionVar -q unparentRemove`;
    radioButtonGrp -e -sl ($remove ? 2 : 1) unparentMethod;
    checkBoxGrp -e -v1 `optionVar -q unparentPreserve` -en1 (!$remove) unparentCheck;
}

global proc unparentCallback(string $parent, int $doIt)
{
    setParent $parent;
    optionVar -iv unparentRemove (`radioButtonGrp -q -sl unparentMethod` == 2);
    optionVar -iv unparentPreserve `checkBoxGrp -q -v1 unparentCheck`;
    if ($doIt) {
        performUnparent 0;
        if (`exists addToRecentCommandQueue`)
            addToRecentCommandQueue "performUnparent 0" "UnParent";
    }
}
