// performPlayblast: Windows > Playblast, its option box and the Time Slider's Playblast. The settings are optionVars,
// read each time a playblast is made, so scripts can set them and then call performPlayblast.

// One value under the category "Animation.Playback.Playblast", written when the var is missing, or always when forced.
proc pbInitInt(int $force, string $name, int $value)
{
    optionVar -init $force -category "Animation.Playback.Playblast" -intValue $name $value;
}

proc pbInitFloat(int $force, string $name, float $value)
{
    optionVar -init $force -category "Animation.Playback.Playblast" -floatValue $name $value;
}

proc pbInitString(int $force, string $name, string $value)
{
    optionVar -init $force -category "Animation.Playback.Playblast" -stringValue $name $value;
}

global proc setPlayblastOptionVars(int $forceFactorySettings)
{
    // Decided before the defaults go in: a first run or a reset names the file after the scene.
    int $setFile = $forceFactorySettings || !`optionVar -exists playblastFile`;

    int $f = $forceFactorySettings;
    string $format = "qt";
    string $compression = "none";
    if (`about -nt`) {
        $format = "avi";
    } else if (`about -mac`) {
        $format = "avfoundation";
        $compression = "jpeg";
    }
    pbInitInt($f, "playblastUseStartEnd", 0);
    pbInitFloat($f, "playblastStartTime", 1.0);
    pbInitFloat($f, "playblastEndTime", 10.0);
    pbInitInt($f, "playblastViewerOn", 1);
    pbInitInt($f, "playblastMultiCamera", 0);
    pbInitString($f, "playblastFormat", $format);
    pbInitString($f, "playblastCompression", $compression);
    pbInitInt($f, "playblastQuality", 70);
    pbInitFloat($f, "playblastScale", 0.5);
    pbInitInt($f, "playblastSaveToFile", 0);
    pbInitInt($f, "playblastSaveDepth", 0);
    pbInitString($f, "playblastFile", "playblast");
    pbInitInt($f, "playblastUseSequenceTime", 0);
    pbInitInt($f, "playblastShowOrnaments", 1);
    // 1 from the window, 2 from the render settings, 3 custom.
    pbInitInt($f, "playblastDisplaySizeSource", 1);
    pbInitInt($f, "playblastWidth", 256);
    pbInitInt($f, "playblastHeight", 256);
    pbInitInt($f, "playblastClearCache", 1);
    pbInitInt($f, "playblastPartialSave", 0);
    pbInitInt($f, "playblastOffscreen", 0);
    pbInitInt($f, "playblastPadding", 4);

    if ($setFile) {
        string $name = basenameEx(`file -query -sceneName`);
        if ($name != "")
            optionVar -stringValue playblastFile $name;
    }
}

global proc playblastSetup(string $parent, int $forceFactorySettings)
{
    setPlayblastOptionVars($forceFactorySettings);
    setParent $parent;

    int $useStartEnd = `optionVar -query playblastUseStartEnd`;
    radioButtonGrp -edit -select ($useStartEnd + 1) useStartEnd;
    floatFieldGrp -edit -value1 `optionVar -query playblastStartTime` -enable $useStartEnd startTime;
    floatFieldGrp -edit -value1 `optionVar -query playblastEndTime` -enable $useStartEnd endTime;

    checkBoxGrp -edit -value1 `optionVar -query playblastUseSequenceTime` useSequenceTimeWidget;
    checkBoxGrp -edit -value1 `optionVar -query playblastOffscreen` offscreen;
    checkBoxGrp -edit -value1 `optionVar -query playblastViewerOn` viewerOn;
    checkBoxGrp -edit -value1 `optionVar -query playblastShowOrnaments` showOrnaments;
    checkBoxGrp -edit -value1 `optionVar -query playblastMultiCamera` multiCameraOutput;

    // A format this machine can't write gives way to the first it can.
    string $format = `optionVar -query playblastFormat`;
    string $formats[] = `playblast -query -format`;
    if (stringArrayFind($format, 0, $formats) < 0)
        $format = size($formats) ? $formats[0] : "";
    if (!catchQuiet(`optionMenuGrp -edit -value $format playblastFormatWidget`))
        changePlayblastFormat($parent);

    intSliderGrp -edit -value `optionVar -query playblastQuality` playblastQualityWidget;
    floatSliderGrp -edit -value `optionVar -query playblastScale` percent;
    intSliderGrp -edit -value `optionVar -query playblastPadding` pad;

    int $source = `optionVar -query playblastDisplaySizeSource`;
    intFieldGrp -edit -value1 `optionVar -query playblastWidth` -value2 `optionVar -query playblastHeight`
        -enable ($source == 3) displaySizeField;
    optionMenuGrp -edit -select $source displaySizeMenu;

    int $save = `optionVar -query playblastSaveToFile`;
    checkBoxGrp -edit -value1 $save saveToFile;
    playblastSaveToFile($save);
    int $depth = `optionVar -query playblastSaveDepth`;
    checkBoxGrp -edit -value1 $depth saveDepth;
    playblastSaveDepth($depth);

    textFieldGrp -edit -fileName `optionVar -query playblastFile` movieFileName;
    checkBoxGrp -edit -value1 `optionVar -query playblastClearCache` clearCache;
    checkBoxGrp -edit -value1 (!`optionVar -query playblastPartialSave`) removePartial;
}

global proc playblastCallback(string $parent, int $doIt)
{
    setParent $parent;

    optionVar -intValue playblastUseStartEnd (`radioButtonGrp -query -select useStartEnd` - 1);
    optionVar -floatValue playblastStartTime `floatFieldGrp -query -value1 startTime`;
    optionVar -floatValue playblastEndTime `floatFieldGrp -query -value1 endTime`;
    optionVar -intValue playblastUseSequenceTime `checkBoxGrp -query -value1 useSequenceTimeWidget`;
    optionVar -intValue playblastViewerOn `checkBoxGrp -query -value1 viewerOn`;
    optionVar -intValue playblastShowOrnaments `checkBoxGrp -query -value1 showOrnaments`;
    optionVar -intValue playblastMultiCamera `checkBoxGrp -query -value1 multiCameraOutput`;
    optionVar -stringValue playblastFormat `optionMenuGrp -query -value playblastFormatWidget`;
    optionVar -stringValue playblastCompression `optionMenuGrp -query -value playblastCompressWidget`;
    optionVar -intValue playblastQuality `intSliderGrp -query -value playblastQualityWidget`;
    optionVar -floatValue playblastScale `floatSliderGrp -query -value percent`;
    optionVar -intValue playblastPadding `intSliderGrp -query -value pad`;
    int $source = `optionMenuGrp -query -select displaySizeMenu`;
    optionVar -intValue playblastDisplaySizeSource $source;
    if ($source == 3) {
        optionVar -intValue playblastWidth `intFieldGrp -query -value1 displaySizeField`;
        optionVar -intValue playblastHeight `intFieldGrp -query -value2 displaySizeField`;
    }
    optionVar -intValue playblastSaveToFile `checkBoxGrp -query -value1 saveToFile`;
    optionVar -intValue playblastSaveDepth `checkBoxGrp -query -value1 saveDepth`;
    optionVar -stringValue playblastFile `textFieldGrp -query -fileName movieFileName`;
    optionVar -intValue playblastClearCache `checkBoxGrp -query -value1 clearCache`;
    optionVar -intValue playblastPartialSave (!`checkBoxGrp -query -value1 removePartial`);
    // Render offscreen is written by its own check box as it changes.

    string $again = "";
    if ($doIt == 1) {
        performPlayblast 0;
        $again = "performPlayblast 0";
    } else if ($doIt == 2) {
        performPlayblast 3;
        $again = "performPlayblast 3";
    }
    if ($again != "")
        addToRecentCommandQueue($again, "PlayBlast");
}

global proc int playblastUpdateMovieName(string $filename, string $fileType)
{
    string $ext = fileExtension($filename);
    if ($ext != "")
        $filename = substring($filename, 1, size($filename) - size($ext) - 1);
    if (`textFieldGrp -exists movieFileName`)
        textFieldGrp -edit -fileName $filename movieFileName;
    optionVar -stringValue playblastFile $filename;
    return 1;
}

global proc changePlayblastEncoding(string $parent)
{
    setParent $parent;
    string $format = `optionMenuGrp -query -value playblastFormatWidget`;
    string $encoding = `optionMenuGrp -query -value playblastCompressWidget`;
    intSliderGrp -edit -enable (!($format == "image" || ($format == "avfoundation" && $encoding == "H.264")))
        playblastQualityWidget;
    checkBoxGrp -edit -enable ($encoding == "maya") saveDepth;
    intSliderGrp -edit -enable ($format == "image") pad;
    checkBoxGrp -edit -enable ($format != "image") removePartial;
}

global proc changePlayblastFormat(string $parent)
{
    setParent $parent;
    if (!`optionMenuGrp -exists playblastCompressWidget`)
        return;
    string $format = `optionMenuGrp -query -value playblastFormatWidget`;
    string $encodings[] = `playblast -format $format -query -compression`;
    optionVar -stringValue playblastFormat $format;
    if ($format != "image" && size($encodings) == 0)
        $encodings = {"none"};

    string $items[] = `optionMenuGrp -query -itemListLong playblastCompressWidget`;
    for ($i in $items)
        deleteUI -menuItem $i;
    // Items go into the menu inside the group; Aztek's group takes them itself.
    string $inner = $parent + "|playblastCompressWidget|OptionMenu";
    if (`menu -exists $inner`)
        setParent -menu $inner;
    else
        setParent -menu playblastCompressWidget;
    // "global" means the render settings' choice; it stays as it is in every language.
    if ($format == "image")
        menuItem -label "global";
    for ($e in $encodings)
        menuItem -label $e;
    setParent $parent;

    string $want = `optionVar -query playblastCompression`;
    if (stringArrayFind($want, 0, $encodings) < 0) {
        if ($format == "qt")
            $want = `about -linux` ? "png" : "PNG";
        else if ($format == "image")
            $want = "global";
        else if ($format == "webm")
            $want = "vp8";
        else
            $want = "none";
        if (stringArrayFind($want, 0, $encodings) < 0 && size($encodings))
            $want = $encodings[0];
    }
    catchQuiet(`optionMenuGrp -edit -value $want playblastCompressWidget`);
    changePlayblastEncoding($parent);
}

global proc playblastOffscreenChange()
{
    optionVar -intValue playblastOffscreen `checkBoxGrp -query -value1 offscreen`;
}

global proc playblastSaveToFile(int $on)
{
    if ($on) {
        checkBoxGrp -edit -value1 true saveToFile;
        textFieldGrp -edit -enable true movieFileName;
        iconTextButton -edit -enable true browser;
    } else {
        // A playblast has to go somewhere: no file means the viewer.
        checkBoxGrp -edit -value1 true viewerOn;
        checkBoxGrp -edit -value1 false saveToFile;
        textFieldGrp -edit -enable false movieFileName;
        iconTextButton -edit -enable false browser;
    }
}

global proc playblastSaveDepth(int $on)
{
    optionVar -intValue playblastSaveDepth ($on ? 1 : 0);
}

global proc playblastDisplaySizeMenuCB(string $tabLayout)
{
    setParent $tabLayout;
    intFieldGrp -edit -enable (`optionMenuGrp -query -select displaySizeMenu` == 3) displaySizeField;
}

global proc playblastFileBrowser()
{
    string $stored = `optionVar -exists playblastFile` ? `optionVar -query playblastFile` : "";
    int $absolute = ($stored != "" && (startsWith($stored, "/") || startsWith($stored, "$")));
    string $format = `optionMenuGrp -query -value playblastFormatWidget`;
    string $type = ($format == "image") ? "image" : "movie";
    string $rule = ($format == "image") ? "images" : "movie";

    string $start = "";
    if (!$absolute) {
        string $dir = `workspace -query -fileRuleEntry $rule`;
        if ($dir != "") {
            if (`exists setWorkingDirectory`)
                eval("setWorkingDirectory \"" + encodeString(`workspace -query -fullName`) + "\" \"" + $type + "\" \""
                     + encodeString($dir) + "\"");
            $start = startsWith($dir, "/") ? $dir : (`workspace -query -fullName` + "/" + $dir);
        }
    }

    if (`exists fileBrowser`) {
        eval("fileBrowser \"playblastUpdateMovieName\" \"Browse\" \"" + $type + "\" 1");
        return;
    }
    // Without the installation's file browser procedure, the browser itself, for a file to write.
    string $picked[];
    if ($start != "")
        $picked = `fileDialog2 -fileMode 0 -caption "Browse" -okCaption "Browse" -startingDirectory $start`;
    else
        $picked = `fileDialog2 -fileMode 0 -caption "Browse" -okCaption "Browse"`;
    if (size($picked) && $picked[0] != "")
        playblastUpdateMovieName(fromNativePath($picked[0]), $type);
}

// The option box, built here when Aztek's own Playblast Options window isn't there (as with no interface).
proc pbOptionBox(int $hideTimeRange)
{
    string $win = "playblastOptionsWindow";
    if (`window -exists $win`)
        deleteUI -window $win;
    window -title "Playblast Options" -widthHeight 520 640 $win;
    string $form = `formLayout -visible false`;
    string $content = `scrollLayout -childResizable true`;
    string $tab = `columnLayout -adjustableColumn true`;
    string $q = "\"" + $tab + "\"";

    frameLayout -borderVisible false -labelVisible false -collapsable true -collapse $hideTimeRange startEndFrame;
    columnLayout -adjustableColumn true;
        string $timeSlider = `exists localizedUIComponentLabel` ? eval("localizedUIComponentLabel \"Time Slider\"")
                                                                  : "Time Slider";
        radioButtonGrp -numberOfRadioButtons 2 -label "Time range" -label1 $timeSlider -label2 "Start/End" -select 1
            -onCommand2 "floatFieldGrp -edit -enable true startTime; floatFieldGrp -edit -enable true endTime;"
            -onCommand1 "floatFieldGrp -edit -enable false startTime; floatFieldGrp -edit -enable false endTime;"
            useStartEnd;
        floatFieldGrp -label "Start time" -value1 0.0 -enable false startTime;
        floatFieldGrp -label "End time" -value1 10.0 -enable false endTime;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Use sequence time" -label1 "" useSequenceTimeWidget;
        separator;
    setParent ..;
    setParent ..;

    frameLayout -borderVisible false -labelVisible false -collapsable false optionsFrame;
    columnLayout -adjustableColumn true;
        checkBoxGrp -numberOfCheckBoxes 1 -label "View" -label1 "" -value1 true
            -offCommand1 "playblastSaveToFile true" viewerOn;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Show ornaments" -label1 "" showOrnaments;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Render offscreen" -label1 "" -changeCommand "playblastOffscreenChange"
            offscreen;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Multi-camera output" -label1 "" -visible true multiCameraOutput;
        separator;
        optionMenuGrp -label "Format" -changeCommand ("changePlayblastFormat " + $q) playblastFormatWidget;
            string $formats[] = `playblast -query -format`;
            for ($f in $formats)
                menuItem -label $f;
        optionMenuGrp -label "Encoding" -changeCommand ("changePlayblastEncoding " + $q) playblastCompressWidget;
            menuItem -label "none";
        intSliderGrp -field true -label "Quality" -minValue 0 -maxValue 100 -step 20 playblastQualityWidget;
        intSliderGrp -field true -label "Frame padding" -minValue 0 -maxValue 10 -fieldMinValue 0 -fieldMaxValue 25
            -enable false pad;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Save depth" -label1 "" -value1 false
            -changeCommand "playblastSaveDepth #1" saveDepth;
        separator;
        optionMenuGrp -label "Display size" -changeCommand ("playblastDisplaySizeMenuCB \"" + $content + "\"")
            displaySizeMenu;
            menuItem -label "From window";
            menuItem -label "From render settings";
            menuItem -label "Custom";
        intFieldGrp -label "" -numberOfFields 2 displaySizeField;
        floatSliderGrp -field true -label "Scale" -minValue 0.1 -maxValue 1.0 -precision 2 percent;
        separator;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Remove temporary files" -label1 "" clearCache;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Remove partial files" -label1 ""
            -annotation "Deletes what was written if the playblast is stopped partway." -enable false removePartial;
        checkBoxGrp -numberOfCheckBoxes 1 -label "Save to file" -label1 "" -value1 false
            -changeCommand "playblastSaveToFile #1" saveToFile;
        rowLayout -numberOfColumns 3 -adjustableColumn 2 -columnWidth 3 50;
            text -label "Movie file";
            textFieldGrp -label "" -enable false movieFileName;
            iconTextButton -style "iconOnly" -image "navButtonBrowse.png" -enable false -command "playblastFileBrowser"
                browser;
        setParent ..;
    setParent ..;
    setParent ..;

    setParent $form;
    string $buttons = `rowLayout -numberOfColumns 4`;
        // Hidden first: the playblast brings the main window forward to capture it.
        button -label "Playblast"
            -command ("window -edit -visible false " + $win + "; playblastCallback " + $q + " " + (1 + $hideTimeRange)
                      + "; deleteUI -window " + $win) playblastDoItBtn;
        button -label "Save" -command ("playblastCallback " + $q + " false; deleteUI -window " + $win) playblastSaveBtn;
        button -label "Reset" -command ("playblastSetup " + $q + " true") playblastResetBtn;
        button -label "Close" -command ("deleteUI -window " + $win) playblastCloseBtn;
    setParent ..;
    formLayout -edit
        -attachForm $content "top" 0 -attachForm $content "left" 0 -attachForm $content "right" 0
        -attachControl $content "bottom" 5 $buttons
        -attachForm $buttons "left" 5 -attachForm $buttons "right" 5 -attachForm $buttons "bottom" 5
        -visible true $form;

    playblastSetup($tab, false);
    showWindow $win;
}

global proc playblastOptions(int $hideTimeRange)
{
    // Aztek's own Playblast Options window when the interface has it; it keeps its own settings.
    if (`exists PlayblastOptions`) {
        eval("PlayblastOptions");
        return;
    }
    pbOptionBox($hideTimeRange);
}

// A quoted, comma separated list for the command text.
proc string pbQuoted(string $list[], string $sep)
{
    string $q[];
    for ($i = 0; $i < size($list); $i++)
        $q[$i] = "\"" + encodeString($list[$i]) + "\"";
    return stringArrayToString($q, $sep);
}

// The 21 values the playblast is made with, in doPlayblastArgList's order.
proc string[] pbValues(int $timeSliderHighlight)
{
    setPlayblastOptionVars(0);
    int $useStartEnd = $timeSliderHighlight ? 0 : `optionVar -query playblastUseStartEnd`;
    string $format = `optionVar -query playblastFormat`;
    string $file = `optionVar -query playblastFile`;
    if (dirname($file) == "") {
        string $entry = `workspace -query -fileRuleEntry (($format == "image") ? "images" : "movie")`;
        string $parts[];
        tokenize $entry ";" $parts;
        if (size($parts) && $parts[0] != "")
            $file = $parts[0] + "/" + $file;
    }
    string $v[];
    $v[0] = `optionVar -query playblastSaveToFile`;
    $v[1] = $file;
    $v[2] = `optionVar -query playblastViewerOn`;
    $v[3] = $format;
    $v[4] = `optionVar -query playblastShowOrnaments`;
    $v[5] = `optionVar -query playblastScale`;
    $v[6] = `optionVar -query playblastCompression`;
    $v[7] = `optionVar -query playblastDisplaySizeSource`;
    $v[8] = `optionVar -query playblastWidth`;
    $v[9] = `optionVar -query playblastHeight`;
    $v[10] = $useStartEnd;
    $v[11] = `optionVar -query playblastStartTime`;
    $v[12] = `optionVar -query playblastEndTime`;
    $v[13] = `optionVar -query playblastClearCache`;
    $v[14] = `optionVar -query playblastOffscreen`;
    $v[15] = `optionVar -query playblastPadding`;
    $v[16] = `optionVar -query playblastUseSequenceTime`;
    $v[17] = `optionVar -query playblastQuality`;
    $v[18] = `optionVar -query playblastSaveDepth`;
    $v[19] = `optionVar -query playblastPartialSave`;
    $v[20] = "";
    return $v;
}

proc string pbCommand(string $setups[], string $ids[], string $values[])
{
    return "doPlayblastArgList 7 { " + pbQuoted($setups, ", ") + " } {  " + pbQuoted($ids, ", ") + " } { "
         + pbQuoted($values, ",") + " };";
}

// Without the installation's doPlayblastArgList, the same values passed to Aztek's playblast command. Depth, partial
// files and the camera setups have no flags there yet.
proc pbRun(string $v[])
{
    string $cmd = "playblast";
    if ($v[10] == "1") {
        $cmd += " -startTime " + $v[11] + " -endTime " + $v[12];
    } else {
        // The highlighted part of the Time Slider when there is one, else the playback range.
        global string $gPlayBackSlider;
        int $range = 0;
        if ($gPlayBackSlider != "" && `exists timeControl` && !catchQuiet(`timeControl -query -rangeVisible $gPlayBackSlider`))
            $range = `timeControl -query -rangeVisible $gPlayBackSlider`;
        if ($range) {
            float $r[] = `timeControl -query -rangeArray $gPlayBackSlider`;
            $cmd += " -startTime " + $r[0] + " -endTime " + ($r[1] - 1);
        } else {
            $cmd += " -startTime " + `playbackOptions -query -minTime` + " -endTime " + `playbackOptions -query -maxTime`;
        }
    }
    $cmd += " -format \"" + $v[3] + "\"";
    if ($v[6] != "" && $v[6] != "none" && $v[6] != "global")
        $cmd += " -compression \"" + $v[6] + "\"";
    $cmd += " -quality " + $v[17] + " -percent " + (int)((float)$v[5] * 100 + 0.5);
    $cmd += " -viewer " + $v[2] + " -showOrnaments " + $v[4] + " -offScreen " + $v[14];
    $cmd += " -clearCache " + $v[13] + " -sequenceTime " + $v[16] + " -framePadding " + $v[15];
    if ($v[7] == "3") {
        $cmd += " -widthHeight " + $v[8] + " " + $v[9];
    } else if ($v[7] == "2") {
        if (!catchQuiet(`getAttr defaultResolution.width`))
            $cmd += " -widthHeight " + `getAttr defaultResolution.width` + " " + `getAttr defaultResolution.height`;
    }
    if ($v[0] == "1")
        $cmd += " -forceOverwrite -filename \"" + encodeString($v[1]) + "\"";
    if ($v[20] != "")
        $cmd += " -editorPanelName \"" + $v[20] + "\"";
    evalEcho($cmd);
}

proc string pbBuildAndRun(string $setups[], string $ids[], int $run, int $timeSliderHighlight)
{
    string $v[] = pbValues($timeSliderHighlight);
    string $cmd = pbCommand($setups, $ids, $v);
    if ($run) {
        if (`exists doPlayblastArgList`)
            eval($cmd);
        else
            pbRun($v);
    }
    return $cmd;
}

// The view a playblast captures. Asked with -query: Aztek's playblast without it would make one.
proc string pbActiveEditor()
{
    return `playblast -query -activeEditor`;
}

global proc string performPlayblast(int $action)
{
    int $multi = `optionVar -exists playblastMultiCamera` ? `optionVar -query playblastMultiCamera` : 0;

    if ($action == 1) {
        playblastOptions 0;
        return "";
    }
    if ($action == 4) {
        playblastOptions 1;
        return "";
    }
    if ($action != 0 && $action != 2 && $action != 3)
        return "";

    int $run = ($action != 2);
    int $highlight = ($action == 3);
    string $none[];
    string $cmd;

    string $editor = pbActiveEditor();
    int $stereo = 0;
    if ($editor != "" && !catchQuiet(`modelEditor -query -stereoDrawMode $editor`))
        $stereo = `modelEditor -query -stereoDrawMode $editor`;
    if ($stereo) {
        warning -noContext "The view is in stereo, so the playblast is made with multi-camera output.";
        $multi = 1;
    }

    if ($multi) {
        $editor = pbActiveEditor();
        string $setups[], $ids[];
        string $mode = "";
        if ($editor == "") {
            warning -noContext "Multi-camera output needs a view to capture; none is active.";
        } else {
            string $pairs[];
            if (!catchQuiet(`modelEditor -query -cameraSetup $editor`))
                $pairs = `modelEditor -query -cameraSetup $editor`;
            if (size($pairs) == 1 && $pairs[0] == "")
                clear $pairs;
            int $n = size($pairs) / 2;
            if ($n == 0) {
                warning -noContext "The active view has no camera setup for multi-camera output.";
            } else if ($n % 2) {
                warning -noContext "The active view's camera setup is malformed.";
            } else {
                if (`exists stereoCameraView`)
                    $mode = eval("stereoCameraView -query -displayMode \"" + $editor + "\"");
                for ($i = 0; $i < $n; $i++) {
                    $ids[$i] = $pairs[2 * $i];
                    $setups[$i] = $pairs[2 * $i + 1];
                }
            }
        }
        $cmd = pbBuildAndRun($setups, $ids, $run, $highlight);
        if ($mode != "")
            eval("stereoCameraView -edit -displayMode \"" + $mode + "\" \"" + $editor + "\"");
    } else {
        $cmd = pbBuildAndRun($none, $none, $run, $highlight);
    }
    return $cmd;
}
