        -columnAlign4 "right" "left" "left" "left" -columnAttach4 "both" "both" "both" "both"
        -columnOffset4 5 $cs 0 0 -columnWidth4 132 62 124 63;
    colorSliderGrp -defineTemplate ToolOptionBoxTemplate -label "" -rgbValue 0 0 0
        -columnAlign3 "right" "left" "left" -columnAttach3 "both" "both" "both" -columnOffset3 5 $cs 0
        -columnWidth3 132 62 124;
    if (`exists colorSliderButtonGrp`)
        colorSliderButtonGrp -defineTemplate ToolOptionBoxTemplate -label "" -buttonLabel $map
            -image "navButtonConnected.png" -rgbValue 0 0 0 -symbolButtonDisplay true
            -columnAlign5 "right" "left" "left" "left" "left" -columnAttach5 "both" "both" "both" "both" "both"
            -columnOffset5 5 $cs 0 0 0 -columnWidth5 132 62 124 38 25;

    // ---- ModelingToolkitTemplate ----
    if (!`uiTemplate -exists ModelingToolkitTemplate`)
        uiTemplate ModelingToolkitTemplate;
    frameLayout -defineTemplate ModelingToolkitTemplate -marginWidth 3 -font "boldLabelFont";
    catchQuiet(`frameLayout -defineTemplate ModelingToolkitTemplate -backgroundShade true`);
    separator -defineTemplate ModelingToolkitTemplate -style "none" -height 2;
}
