// performParent: Edit > Parent, as the reference's, its settings kept in optionVars. $action 0 parents the selection
// (the last selected object takes the others) and returns the command, 1 opens the option box, 2 only returns the
// command; anything else returns "".

proc performParent_options(int $force)
{
    optionVar -init $force -category "Edit.Parent"
        -iv parentAdd 0
        -iv parentPreserve 1;
}

global proc string performParent(int $action)
{
    if ($action == 1) {
        // This box sets no command name for its Help item.
        string $layout = getOptionBox();
        setParent $layout;
        // Aztek doesn't define the reference's DefaultTemplate yet; the controls keep their plain look without it.
        int $template = `uiTemplate -ex DefaultTemplate`;
        if ($template)
            setUITemplate -pst DefaultTemplate;
        waitCursor -st 1;
        tabLayout -scr true -tv false;
        string $parent = `columnLayout -adj true`;
        // Preserve position has no meaning for an added instance, so it greys out while that is chosen.
        string $check = $parent + "|parentCheck";
        radioButtonGrp -nrb 2 -l "Parent method:" -la2 "Move objects" "Add instance"
            -on2 ("checkBoxGrp -e -en1 false " + $check) -of2 ("checkBoxGrp -e -en1 true " + $check) parentMethod;
        checkBoxGrp -ncb 1 -l1 "Preserve position" parentCheck;
        waitCursor -st 0;
        if ($template)
            setUITemplate -ppt;

        button -e -l "Parent" -c ("performParentCallback " + $parent + " 1") (getOptionBoxApplyBtn());
        button -e -c ("performParentCallback " + $parent + " 0; hideOptionBox") (getOptionBoxSaveBtn());
        button -e -c ("performParentSetup " + $parent + " 1") (getOptionBoxResetBtn());
        setOptionBoxTitle("Parent Options");
        setOptionBoxHelpTag("Parent");
        performParentSetup $parent 0;
        showOptionBox();
        return "";
    }
    if ($action != 0 && $action != 2)
        return "";

    performParent_options(0);
    string $cmd = "parentPreset(" + `optionVar -q parentAdd` + "," + `optionVar -q parentPreserve` + ")";
    if ($action == 0)
        eval $cmd;
    return $cmd;
}

global proc performParentSetup(string $parent, int $forceFactorySettings)
{
    performParent_options($forceFactorySettings);
    setParent $parent;
    int $add = `optionVar -q parentAdd`;
    radioButtonGrp -e -sl ($add ? 2 : 1) parentMethod;
    checkBoxGrp -e -v1 `optionVar -q parentPreserve` -en1 (!$add) parentCheck;
}

global proc performParentCallback(string $parent, int $doIt)
{
    setParent $parent;
    optionVar -iv parentAdd (`radioButtonGrp -q -sl parentMethod` == 2);
    // Kept even while greyed out, as the command is given it either way.
    optionVar -iv parentPreserve `checkBoxGrp -q -v1 parentCheck`;
    if ($doIt) {
        performParent 0;
        addToRecentCommandQueue "performParent 0" "Parent";
    }
}
