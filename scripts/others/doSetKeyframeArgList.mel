// doSetKeyframeArgList: the keying behind Set Key, Set Breakdown and the Set Key option box. Builds setKeyframe commands
// for what is to be keyed, optionally at times the user types, and keys IK/FK and full body IK as asked. Gives back
// how many attributes were keyed.
//
// $version says how many of $args are read (later ones count as 0 or empty):
//   1: [0] which: 1 keyable attributes of the targets, 2 all manipulator handle attributes, 3 the current handle's,
//          4 the manipulator handles' and then the keyable attributes; [1] hierarchy below; [2] channel box selection;
//      [3] control points; [4] shapes
//   2: [5] prompt for times   3: [6] breakdown, [7] selection connection   4: [8] IK/FK   5: [9] full body IK
//   6: [10] zero key on animation layers   7: [11] keyed from the Time Editor, [12] preserve curve shape

// The channel box's selected objects and attributes. Aztek has no channel box command for scripts yet, so it is taken
// as having nothing selected when the procedures that ask it are missing.
proc string[] dskChannelBoxObjects()
{
    if (`exists selectedChannelBoxObjects`)
        return eval("selectedChannelBoxObjects");
    return {};
}

proc string[] dskChannelBoxAttributes()
{
    if (`exists selectedChannelBoxAttributes`)
        return eval("selectedChannelBoxAttributes");
    return {};
}

proc int dskIsFullBodyIKObject(string $obj)
{
    if (`exists isFullBodyIKObject`)
        return eval("isFullBodyIKObject \"" + encodeString($obj) + "\" 0");
    return 0;
}

// The manipulator handle attributes ($handle 0: every one, 1: the current handle's).
proc string[] dskManipAttributes(int $currentHandle)
{
    string $attrs[];
    if ($currentHandle)
        $attrs = `listAnimatable -manipHandle`;
    else
        $attrs = `listAnimatable -manip`;
    return $attrs;
}

// The node part of each attribute name.
proc string[] dskNodesOf(string $attrs[])
{
    string $nodes[];
    for ($a in $attrs) {
        string $parts[];
        tokenize $a "." $parts;
        $nodes[size($nodes)] = size($parts) ? $parts[0] : "";
    }
    return $nodes;
}

proc dskCallIkFK(string $names[])
{
    string $list = size($names) ? ("{\"" + stringArrayToString($names, "\",\"") + "\"}") : "{}";
    catch(eval("ikFK 0 " + $list));
}

// Every transform in a character, through its sub-characters too.
proc string[] dskCharacterTransforms(string $character)
{
    string $found[];
    string $members[];
    if (catchQuiet($members = `character -query -nodesOnly $character`))
        return $found;
    for ($m in $members) {
        if (`objectType -isType "character" $m`)
            appendStringArray($found, dskCharacterTransforms($m), size(dskCharacterTransforms($m)));
        else if (`objectType -isAType "transform" $m`)
            $found[size($found)] = $m;
    }
    return $found;
}

// Keys IK handles and joints in IK/FK mode for the names given.
proc dskIkFKPass(string $names[])
{
    int $allIk = 1;
    for ($n in $names) {
        if (!`objectType -isType "ikHandle" $n` && !`objectType -isType "joint" $n`) {
            $allIk = 0;
            break;
        }
    }
    if ($allIk) {
        dskCallIkFK($names);
        return;
    }

    // Characters bring in every transform they hold.
    string $added[];
    for ($n in $names)
        if (`objectType -isType "character" $n`)
            appendStringArray($added, dskCharacterTransforms($n), size(dskCharacterTransforms($n)));
    if (size($added)) {
        $added = sort(stringArrayRemoveDuplicates($added));
        appendStringArray($names, $added, size($added));
        $names = sort(stringArrayRemoveDuplicates($names));
    }

    string $handles[], $joints[], $others[];
    for ($n in $names) {
        if (`objectType -isType "ikHandle" $n`)
            $handles[size($handles)] = $n;
        else if (`objectType -isType "joint" $n`)
            $joints[size($joints)] = $n;
        else if (`objExists $n` && (`attributeQuery -node $n -exists "solverEnable"`
            || `attributeQuery -node $n -exists "ikBlend"`))
            $others[size($others)] = $n;
    }
    string $all[] = stringArrayCatenate($handles, $joints);
    $all = stringArrayCatenate($all, $others);
    if (size($all))
        dskCallIkFK($all);
}

// A message about keys from the Time Editor or a scene, where the Time Editor's message procedure is missing.
proc dskTimeEditorMessage(string $message)
{
    if (`exists timeEditorInViewMessage`)
        eval("timeEditorInViewMessage \"" + encodeString($message) + "\"");
    else
        warning $message;
}

proc dskNoObjectsWarning(int $breakdown)
{
    warning ($breakdown ? "Select objects to set breakdowns on." : "Select objects to set keys on.");
}

global proc int doSetKeyframeArgList(string $version, string $args[])
{
    global string $gSetIKFKStepTangentList[];
    global int $gCteSetKeyFrameResult;

    int $ver = $version;
    int $which = $args[0];
    int $hierarchy = 0, $useChannelBox = 0, $controlPoints = 0, $shape = 0;
    if ($which != 4) {
        $hierarchy = $args[1];
        $useChannelBox = $args[2];
        $controlPoints = $args[3];
        $shape = $args[4];
    }
    int $prompt = ($ver >= 2) ? (int)$args[5] : 0;
    int $breakdown = ($ver >= 3) ? (int)$args[6] : 0;
    string $connection = ($ver >= 3) ? $args[7] : "";
    int $useIKFK = ($ver >= 4) ? (int)$args[8] : 0;
    int $useFBIK = ($ver >= 5) ? (int)$args[9] : 0;
    int $zeroKey = ($ver >= 6) ? (int)$args[10] : 0;
    int $fromTimeEditor = ($ver >= 7) ? (int)$args[11] : 0;
    int $preserveShape = ($ver >= 7) ? (int)$args[12] : 0;

    // The channel box only counts when something is selected in it.
    if ($useChannelBox && size(dskChannelBoxObjects()) == 0 && size(dskChannelBoxAttributes()) == 0)
        $useChannelBox = 0;

    if (`exists loadFullBodyIKFunctions`)
        eval "loadFullBodyIKFunctions";

    // Full body IK rigs are keyed by their own keyer, and that is all.
    if ($useFBIK) {
        string $selected[] = `ls -selection`;
        int $hasFBIK = 0;
        for ($s in $selected) {
            if (dskIsFullBodyIKObject($s)) {
                $hasFBIK = 1;
                break;
            }
        }
        if ($hasFBIK) {
            string $mode = "1";
            if (`optionVar -exists keyFullBody`) {
                int $k = `optionVar -query keyFullBody`;
                if ($k == 1) $mode = "1";
                else if ($k == 2) $mode = "2";
                else if ($k == 3) $mode = "4";
            }
            return doSetFullBodyIKKeysArgList("3", {$mode, "4"});
        }
    }

    clear($gSetIKFKStepTangentList);
    $gCteSetKeyFrameResult = 1;

    // Typed times and IK/FK keys don't go together.
    if ($prompt)
        $useIKFK = 0;

    string $cmd = "setKeyframe -breakdown " + $breakdown + " ";
    // Aztek's setKeyframe has no -preserveCurveShape yet: keys are set without it.
    if ($preserveShape)
        warning "Preserve curve shape isn't available yet; keys are set without it.";
    if ($zeroKey)
        $cmd += "-id -itt flat -dd true ";

    if ($prompt) {
        string $answer = `promptDialog -title ($breakdown ? "Set Breakdown" : "Set Key")
            -message "Times to key, separated by spaces or commas:" -text ""
            -button "OK" -button "Cancel" -defaultButton "OK" -cancelButton "Cancel" -dismissString "Cancel"`;
        if ($answer != "OK")
            return 0;
        string $text = `promptDialog -query -text`;
        string $times[];
        tokenize $text " ,\t\n" $times;
        if (size($times) == 0) {
            if ($text != "")
                error "That isn't a list of times.";
            return 0;
        }
        int $any = 0;
        for ($t in $times) {
            if ($t != "") {
                $cmd += "-t " + $t + " ";
                $any = 1;
            }
        }
        if (!$any)
            return 0;
    }

    string $targets = expandSelectionConnection($connection);
    int $total = 0;
    int $hasObjects = 0;

    if ($which == 4) {
        string $attrs[] = dskManipAttributes(0);
        if ($useIKFK && size($attrs))
            dskIkFKPass(dskNodesOf($attrs));
        for ($a in $attrs)
            $total += evalEcho($cmd + $a);
    }

    if ($which == 1 || $which == 4) {
        $cmd += $hierarchy == 1 ? "-hierarchy below " : "-hierarchy none ";
        if ($useChannelBox) {
            if ($useIKFK)
                dskIkFKPass(dskChannelBoxObjects());
            string $syntax[];
            if (`exists keySetOptionBoxCommon`)
                $syntax = eval("keySetOptionBoxCommon {\"setKeyframe\",\"unknown\",\"channelBoxSyntax\"}");
            if (size($syntax) == 0 || $syntax[0] == "") {
                warning "Select channels in the channel box to key.";
                return 0;
            }
            $cmd += $syntax[0];
            $total += evalEcho($cmd);
            $hasObjects = 1;
        } else if ($targets != "") {
            if ($useIKFK) {
                string $inner = $targets;
                if (startsWith($inner, "{\""))
                    $inner = substring($inner, 3, size($inner));
                if (endsWith($inner, "\"}"))
                    $inner = substring($inner, 1, size($inner) - 2);
                string $names[];
                tokenize $inner "\", " $names;
                if (size($names))
                    dskIkFKPass($names);
            }
            if ($targets == "{}") {
                dskNoObjectsWarning($breakdown);
            } else {
                $cmd += "-controlPoints " + $controlPoints + " -shape " + $shape + " " + $targets;
                $total += evalEcho($cmd);
                $hasObjects = 1;
            }
        } else {
            string $selected[] = `ls -selection`;
            if ($useIKFK)
                dskIkFKPass($selected);
            $hasObjects = size($selected) > 0;
            $cmd += "-controlPoints " + $controlPoints + " -shape " + $shape;
            if (!$hasObjects && $useIKFK && $total == 0)
                dskNoObjectsWarning($breakdown);
            else if ($hasObjects)
                $total = evalEcho($cmd);
        }
    }

    if ($which == 2 || $which == 3) {
        string $attrs[] = dskManipAttributes($which == 3);
        if ($useIKFK)
            dskIkFKPass(dskNodesOf($attrs));
        for ($a in $attrs)
            $total += evalEcho($cmd + $a);
    }

    if ($total == 0 && $hasObjects) {
        if ($which == 1)
            warning "No keys were set: the selected objects have no keyable attributes.";
        else if ($which == 2)
            warning "No keys were set: there is no manipulator with handles.";
        else if ($which == 3)
            warning "No keys were set: there is no current manipulator handle.";
        else if ($which == 4)
            warning "No keys were set: no manipulator handles or keyable attributes on the selection.";
        if ($fromTimeEditor)
            dskTimeEditorMessage("No key was set in the Time Editor.");
        else if ($gCteSetKeyFrameResult == 0)
            dskTimeEditorMessage("No key was set in the scene.");
    }
    $gCteSetKeyFrameResult = 1;

    // IK/FK keying asks for some keys to get clamped out tangents at the current time.
    if (size($gSetIKFKStepTangentList)) {
        float $now = `currentTime -query`;
        for ($item in $gSetIKFKStepTangentList)
            if (`objExists $item`)
                catch(`keyTangent -edit -time $now -outTangentType clamped $item`);
        clear($gSetIKFKStepTangentList);
    }
    return $total;
}
