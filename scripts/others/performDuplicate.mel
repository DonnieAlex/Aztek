// performDuplicate: Edit > Duplicate, as the reference's. It always uses the factory settings: there is no option box
// and no optionVar. $action 0 duplicates and returns the command, 2 only returns the command, 1 (once the option box)
// and anything else do nothing and return "".

// Whether the selection holds animation clips and the panel being worked in is the clip editor, in which case the clips
// are what gets duplicated. Aztek has no clip editor yet, so this is false there; it is kept for scenes and plug-ins
// that bring one.
proc int performDuplicate_inClipEditor()
{
    string $clips[];
    if (catchQuiet($clips = `ls -sl -type animClip`))
        return 0;
    if (!size($clips))
        return 0;
    string $panel = `getPanel -up`;
    if ($panel == "")
        $panel = `getPanel -wf`;
    if ($panel == "" || `getPanel -to $panel` != "scriptedPanel")
        return 0;
    return `scriptedPanel -q -type $panel` == "clipEditorPanel";
}

global proc string performDuplicate(int $action)
{
    if ($action == 0 && performDuplicate_inClipEditor() && `exists performDuplicateClip`)
        return `performDuplicateClip 0 ""`;
    if ($action != 0 && $action != 2)
        return "";

    // Fixed values: one copy under the parent, nothing extra copied, no offsets.
    int $count = 1, $copy = 1, $groupMode = 1, $smart = 0, $upstream = 0, $inputConns = 0, $renameChildren = 0, $instanceLeaf = 0;
    float $t[] = {0.0, 0.0, 0.0};
    float $r[] = {0.0, 0.0, 0.0};
    float $s[] = {1.0, 1.0, 1.0};
    string $cmd = "duplicatePreset(" + $count + "," + $copy + "," + $groupMode + "," + $smart + "," + $upstream + ","
        + $inputConns + "," + $renameChildren + "," + $instanceLeaf + "," + $t[0] + "," + $t[1] + "," + $t[2] + ","
        + $r[0] + "," + $r[1] + "," + $r[2] + "," + $s[0] + "," + $s[1] + "," + $s[2] + ")";

    if ($action == 0) {
        // duplicatePreset prints what it does itself, so a plain eval.
        eval $cmd;
    }
    return $cmd;
}
