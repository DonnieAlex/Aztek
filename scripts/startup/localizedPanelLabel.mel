// localizedPanelLabel: turns the English label of a panel, editor or panel layout into the one the interface shows.
// Layout and panel scripts call it before looking panels up by label.
//
// Aztek's interface is English, and it has no string catalog, so each label's text is plain English: where several
// English labels share one entry (the reference keeps "Hyper Shade Panel" and "Hypershade" as one), the text is that of
// the first label listed for it. When a catalog is there (displayString), its text is used instead.

global string $gPanelLabels[];

// The table: English label, then the entry it shares with labels of the same meaning. Order counts only in that the
// first label of an entry gives its text.
proc string[] lplTable()
{
    return {
        "Top View", "kTopView",
        "Side View", "kSideView",
        "Front View", "kFrontView",
        "Persp View", "kPerspView",
        "Top Panel", "kTopPanel",
        "Front Panel", "kFrontPanel",
        "Side Panel", "kSidePanel",
        "Persp Panel", "kPerspPanel",
        "Model Panel", "kModelPanel",
        "Perspective", "kPerspective",
        "Single Perspective", "kSinglePerspective",
        "viewPanes", "kViewPanes",
        "Left View", "kLeftView",
        "Right View", "kRightView",
        "Back View", "kBackView",
        "Bottom View", "kBottomView",
        "Relationship Editor", "kRelationshipEditor",
        "Relationship Panel", "kRelationshipEditor",
        "Hypershade", "kHypershade",
        "Hyper Shade Panel", "kHypershade",
        "Visor", "kVisor",
