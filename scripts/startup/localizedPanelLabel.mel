        "Three Panes Side by Side", "kThreePanesSidebySide",
        "Four Panes Split Top", "kFourPanesSplitTop",
        "Four Panes Split Left", "kFourPanesSplitLeft",
        "Four Panes Split Bottom", "kFourPanesSplitBottom",
        "Four Panes Split Right", "kFourPanesSplitRight",
        "Four Panes Stacked", "kFourPanesStacked",
        "Four Panes Side by Side", "kFourPanesSidebySide",
        "Panel Configuration", "kPanelConfig"
    };
}

// The shown text of one entry: the catalog's when it has the entry, else the English of the first label for it.
proc string lplText(string $table[], string $key)
{
    string $full = "m_localizedPanelLabel." + $key;
    if (`exists displayString`) {
        int $there = 0;
        catchQuiet($there = eval("displayString -exists \"" + $full + "\""));
        if ($there)
            return uiRes($full);
    }
    for ($i = 0; $i < size($table); $i += 2) {
        if ($table[$i + 1] == $key)
            return $table[$i];
    }
    return $key;
}

// Every label as [English, shown, English, shown, ...]. Made once and kept.
global proc string[] localizedPanelLabels()
{
    global string $gPanelLabels[];
    if (size($gPanelLabels))
        return $gPanelLabels;

    string $table[] = lplTable();
    string $labels[];
    for ($i = 0; $i < size($table); $i += 2) {
        $labels[$i] = $table[$i];
        $labels[$i + 1] = lplText($table, $table[$i + 1]);
    }
    $gPanelLabels = $labels;
    return $gPanelLabels;
}

// A label split into its words and the number a copied or torn-off panel carries at its end: "Model Panel 3" gives
// {"Model Panel", "3"}, "Hypergraph Hierarchy2" gives {"Hypergraph Hierarchy", "2"}. Without a number the label comes
// back whole (not trimmed) with an empty suffix.
global proc string[] labelBaseAndSuffix(string $label)
{
    string $base = `match "^.*[^0-9]" $label`;
    string $suffix = "";
    if ($base != $label) {
        $suffix = `match "[0-9]+$" $label`;
        $base = strip($base);
    }
    return {$base, $suffix};
}

global proc string localizedPanelLabel(string $englishLabel)
{
    string $parts[] = labelBaseAndSuffix($englishLabel);
    string $labels[] = localizedPanelLabels();

    string $result = "";
    int $found = 0;
    for ($i = 0; $i < size($labels); $i += 2) {
        if ($labels[$i] == $parts[0]) {
            $result = $labels[$i + 1];
            $found = 1;
            break;
        }
    }
    // The number goes straight after the text, with no space, as in the reference.
    if ($parts[1] != "")
        $result += $parts[1];

    if (!$found) {
        $result = $englishLabel;
        // The reference notes labels it can't translate; Aztek has no such log unless a script provides one.
        if (`exists uiToMelMsg`)
            eval("uiToMelMsg \"localizedPanelLabel\" \"" + encodeString($englishLabel) + "\" 0");
    }
    return $result;
}
