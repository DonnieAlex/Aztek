        "Camera Sequencer", "kSequencer",
        "Shot Playlist", "kShotPlaylist",
        "Shot Playlist Panel", "kShotPlaylist",
        "Sequence Editor Panel", "kSequencer",
        "Reference Editor", "kRefEd",
        "Reference Editor Panel", "kRefEd",
        "Web Browser", "kWebBrowser",
        "Web Browser Panel", "kWebBrowser",
        "Paint Effects", "kPaintEffects",
        "Dyn Paint Scripted Panel Type", "kPaintEffects",
        "Outliner", "kOutliner",
        "Outliner Panel", "kOutliner",
        "Content Browser", "kContentBrowser",
        "Content Browser Panel", "kContentBrowser",
        "Graph Editor", "kGraphEditor",
        "Profiler Tool", "kProfilerTool",
        "Profiler Panel", "kProfilerPanel",
        "Dope Sheet", "kDopeSheet",
        "Dope Sheet Panel", "kDopeSheet",
        "Hypergraph", "kHypergraph",
        "Hyper Graph Panel", "kHypergraph",
        "Hypergraph Hierarchy", "kHypergraphHierarchy",
        "Hypergraph InputOutput", "kHypergraphInputOutput",
        "Node Editor", "kNodeEditor",
        "Node Editor Panel", "kNodeEditor",
        "Node Editor InputOutput", "kNodeEditorInputOutput",
        "Create Node", "kCreateNode",
        "Create Node Panel", "kCreateNode",
        "Dynamic Relationships", "kDynamicRelationships",
        "Dyn Rel Ed Panel", "kDynamicRelationships",
        "Render View", "kRenderView",
        "Render Window Panel", "kRenderView",
        "UV Editor", "kUVEditor",
        "UV Texture Editor", "kUVEditor",
        "Poly Texture Placement Panel", "kUVEditor",
        "UV Toolkit", "kUVToolkit",
        "Multilister", "kMultilister",
        "Multi Lister Panel", "kMultilister",
        "Blend Shape", "kBlendShape",
        "Blend Shape Panel", "kBlendShape",
        "Shape Editor", "kShapeEditor",
        "Shape Panel", "kShapeEditor",
        "Pose Editor", "kPoseEditor",
        "Pose Panel", "kPoseEditor",
        "Devices", "kDevices",
        "Device Panel", "kDevices",
        "Component Editor", "kComponentEd",
        "Component Editor Panel", "kComponentEd",
        "Script Editor", "kScriptEditor",
        "Script Editor Panel", "kScriptEditor",
        "Polygon Selection Constraints", "kPolySelectionConstraints",
        "Poly Selection Constraint Panel", "kPolySelectionConstraintPanel",
        "Shading Group Editor", "kShadingGroupEditor",
        "Set Editor", "kSetEditor",
