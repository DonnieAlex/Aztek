global int $gHUDupdateIKScriptJobExists = 0;
global int $gHUDupdateIKScriptJob = 0;

global proc setAnimationDetailsVisibility(int $visibility)
{
    global int $gHUDupdateIKScriptJobExists;
    global int $gHUDupdateIKScriptJob;

    hudShow({"HUDIKSolverState", "HUDCurrentCharacter", "HUDPlaybackSpeed"}, "", $visibility);
    if ($visibility) {
        // The IK state changes with time, so its row is redrawn as time moves while it's shown.
        if (!$gHUDupdateIKScriptJobExists && `headsUpDisplay -exists HUDIKSolverState`) {
            $gHUDupdateIKScriptJob = `scriptJob -event timeChanged "refresh"`;
            $gHUDupdateIKScriptJobExists = 1;
        }
    } else if ($gHUDupdateIKScriptJobExists) {
        catch(`scriptJob -kill $gHUDupdateIKScriptJob -force`);
        $gHUDupdateIKScriptJobExists = 0;
        $gHUDupdateIKScriptJob = 0;
    }
    hudRecord("animationDetailsItem", "animationDetailsVisibility", $visibility);
}

// ---------------------------------------------------------------------------------------------------------------------
// Animation readouts.

global proc string animationDetailsIKFK()
{
    int $last = `optionVar -query ikFKSwitchState`;
    string $sel[] = `ls -selection`;
    // 0 nothing selected, 1 on, 2 off, 3 no solver, 4 mixed.
    int $state = 0;
    if (`exists ikFKSolverState`)
        $state = eval("ikFKSolverState({\"" + stringArrayToString($sel, "\",\"") + "\"})");
    int $canSync = `exists updateIKFKCheckBox`;

    if ($state == 1) {
        float $blend = 0;
        if (`exists ikFkBlendValue`)
            $blend = eval("ikFkBlendValue({\"" + stringArrayToString($sel, "\",\"") + "\"})");
        if ($last != 1 && $canSync)
            eval("updateIKFKCheckBox 1");
        return $blend > 0 ? ("" + $blend) : "Mixed";
    }
    if ($state == 2) {
        if ($last != 0 && $canSync)
            eval("updateIKFKCheckBox 0");
        return "Off";
    }
    if ($state == 4) {
        if ($last == 0 && $canSync)
            eval("updateIKFKCheckBox 1");
        return "Mixed";
    }
    return "No Solver";
}

global proc string animationDetailsCurrentCharacter()
{
    string $chars[];
    if (`exists currentCharacters`)
        $chars = eval("currentCharacters");
    if (size($chars) == 0)
        return "None";
    if (size($chars) == 1)
        return $chars[0];
    return "Multiple";
}

global proc string fbikDetailsKeyType()
{
    int $k = `optionVar -query fbikKeyOption`;
    if ($k == 1)
        return "IK";
    if ($k == 2)
        return "FK";
    return "Simple";
}

global proc string hikDetailsKeyingMode()
{
    if (!`optionVar -exists keyFullBody`)
        optionVar -intValue keyFullBody 1;
    int $k = `optionVar -query keyFullBody`;
    if ($k == 1)
        return "Full Body";
    if ($k == 2)
        return "Body Part";
    return "Selected";
}

global proc string animationDetailsPlaybackSpeed()
{
    float $speed = `playbackOptions -query -playbackSpeed`;
    string $unit = `currentUnit -query -time`;
    int $fps = 0;
    if ($unit == "game")
        $fps = 15;
    else if ($unit == "film")
        $fps = 24;
    else if ($unit == "pal")
        $fps = 25;
    else if ($unit == "ntsc")
        $fps = 30;
    else if ($unit == "show")
        $fps = 48;
    else if ($unit == "palf")
        $fps = 50;
    else if ($unit == "ntscf")
        $fps = 60;

    string $text;
    if (equivalentTol($speed, 0.0, 0.0001))
        $text = "Play Every Frame ";
    else if (equivalentTol($speed, 0.5, 0.0001))
        $text = "Half Speed ";
    else if (equivalentTol($speed, 1.0, 0.0001))
        $text = "Real-time";
    else if (equivalentTol($speed, 2.0, 0.0001))
        $text = "Twice Speed ";
    else
        $text = "Other Speed ";

    float $rate = $fps * $speed;
    if ($rate != 0)
        $text += " [" + $rate + " fps]";
    return $text;
}

