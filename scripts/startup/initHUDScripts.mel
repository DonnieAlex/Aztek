// ---------------------------------------------------------------------------------------------------------------------
// Polygon display.

global proc setPolyDisplayLimitedToSelected()
{
    optionVar -intValue polyDisplayLimitedToSelectedOV (!`optionVar -query polyDisplayLimitedToSelectedOV`);
}

// The Display menu's own procedure, known from start-up.
proc hudToggleSurfaceCulling()
{
    toggleSurfaceBackfaceCulling();
}

global proc setPolyDisplayBackCulling(int $type)
{
    if ($type == 1) {
        optionVar -intValue polyDisplayVertexBackfaceCulling (!`optionVar -query polyDisplayVertexBackfaceCulling`);
        hudToggleSurfaceCulling();
    } else if ($type == 2) {
        int $was = `optionVar -query polyDisplayWireBackfaceCulling`;
        optionVar -intValue polyDisplayWireBackfaceCulling (!$was);
        // Keeping wires and keeping hard edges are two ways of culling: one at a time.
        if (!$was)
            optionVar -intValue polyDisplayHardEdgeBackfaceCulling 0;
        updateCullingOptions();
        hudToggleSurfaceCulling();
    } else {
        int $was = `optionVar -query polyDisplayHardEdgeBackfaceCulling`;
        optionVar -intValue polyDisplayHardEdgeBackfaceCulling (!$was);
        if (!$was)
            optionVar -intValue polyDisplayWireBackfaceCulling 0;
        updateCullingOptions();
        hudToggleSurfaceCulling();
    }
}

global proc updateCullingOptions()
{
    if (`menuItem -exists toggleKeepWireBackCullingItem`)
        menuItem -edit -checkBox `optionVar -query polyDisplayWireBackfaceCulling` toggleKeepWireBackCullingItem;
    if (`menuItem -exists toggleKeepHardEdgesCullingItem`)
        menuItem -edit -checkBox `optionVar -query polyDisplayHardEdgeBackfaceCulling` toggleKeepHardEdgesCullingItem;
}

// Runs a Display menu procedure, sourcing the menu's file the first time.
proc hudDisplayMenuProc(string $call, string $proc)
{
    if (!`exists $proc`)
        catchQuiet(`eval "source \"buildDisplayMenu.mel\""`);
    if (`exists $proc`)
        eval($call);
}

global proc setPolygonDisplaySettings(string $option)
{
    string $sel[] = `ls -selection`;
    int $limited = `optionVar -query polyDisplayLimitedToSelectedOV`;
    // Not limited to the selection: every mesh is selected for the change, then the selection is put back.
    if (!$limited) {
        select -clear;
        string $meshes[] = `ls -type mesh`;
        if (size($meshes))
            select $meshes;
    }

    if ($option == "vertexCulling")
        setPolyDisplayBackCulling(1);
    else if ($option == "keepWire")
        setPolyDisplayBackCulling(2);
    else if ($option == "keepHardEdge")
        setPolyDisplayBackCulling(3);
    else if ($option == "culling")
        hudToggleSurfaceCulling();
    else if ($option == "fNormal")
        hudDisplayMenuProc("toggleNormalDisplay \"face\"", "toggleNormalDisplay");
    else if ($option == "vNormal")
        hudDisplayMenuProc("toggleNormalDisplay \"vertex\"", "toggleNormalDisplay");
    else if ($option == "vertexSize")
        hudDisplayMenuProc("dispWindow \"VertSz\"", "dispWindow");
    else if ($option == "uvSize")
        hudDisplayMenuProc("dispWindow \"UVSz\"", "dispWindow");
    else if ($option == "normalSize")
        hudDisplayMenuProc("dispWindow \"NormSz\"", "dispWindow");
    else if ($option == "edgeWidth")
        hudDisplayMenuProc("dispWindow \"EdgeSz\"", "dispWindow");
    else if ($option == "tangent")
        hudDisplayMenuProc("toggleTangentDisplay", "toggleTangentDisplay");
    else if ($option == "dispEdge")
        polyOptions -allEdges -activeObjects;
    else if ($option == "dispSoftEdge")
        polyOptions -softEdge -activeObjects;
    else if ($option == "dispHardEdge")
        polyOptions -hardEdge -activeObjects;
    else if ($option == "dispHardEdgeColor")
        polyOptions -hardEdgeColor -activeObjects;
    else if ($option == "reset")
        polyOptions -activeObjects -allEdges -sizeBorder 3 -displayBorder 0 -displayCreaseEdge 0 -displayCreaseVertex 0
            -displayTangent 0 -displayMapBorder 0 -displayVertex 0 -displayNormal 0 -facet -displayCenter 0
            -displayTriangle 0 -displayWarp 0 -displayInvisibleFaces 1 -displayItemNumbers 0 0 0 0 -sizeNormal 0.4
            -sizeVertex 3.0 -sizeUV 4.0 -backCulling -displayUVs 0 -displayUVTopology 0 -colorShadedDisplay 0
            -colorMaterialChannel diffuse -backCullVertex 1;
    else if ($option == "verts")
        polyOptions -relative -activeObjects -displayVertex true;
    else if ($option == "borderEdge")
        polyOptions -relative -activeObjects -displayBorder true;
    else if ($option == "creaseEdge")
        polyOptions -relative -activeObjects -displayCreaseEdge 1;
    else if ($option == "creaseVertex")
        polyOptions -relative -activeObjects -displayCreaseVertex 1;
    else if ($option == "textBorderEdge")
        polyOptions -relative -activeObjects -displayMapBorder 1;
    else if ($option == "faceCenter")
        polyOptions -relative -activeObjects -displayCenter true;
    else if ($option == "faceTriangles")
        polyOptions -relative -activeObjects -displayTriangle 1;
    else if ($option == "invisibleFaces")
        polyOptions -relative -activeObjects -displayInvisibleFaces 1;
    else if ($option == "UVs")
        polyOptions -relative -activeObjects -displayUVs true;
    else if ($option == "unsharedUVs")
        polyOptions -relative -activeObjects -displayUVTopology true;
    else if ($option == "vertIDs")
        polyOptions -relative -activeObjects -displayItemNumbers 1 0 0 0;
    else if ($option == "edgeIDs")
        polyOptions -relative -activeObjects -displayItemNumbers 0 1 0 0;
    else if ($option == "faceIDs")
        polyOptions -relative -activeObjects -displayItemNumbers 0 0 1 0;
    else if ($option == "compIDs")
        polyOptions -relative -activeObjects -displayItemNumbers 0 0 0 1;
    else if ($option == "vertMetadata")
        polyOptions -relative -activeObjects -displayMetadata 1 0 0;
    else if ($option == "edgeMetadata")
        polyOptions -relative -activeObjects -displayMetadata 0 1 0;
    else if ($option == "faceMetadata")
        polyOptions -relative -activeObjects -displayMetadata 0 0 1;
    else if ($option == "nonPlanar")
        hudDisplayMenuProc("polyNonPlanarFaceDisplay", "polyNonPlanarFaceDisplay");

    if (!$limited) {
        select -clear;
        if (size($sel))
            select $sel;
    }
}

// A size slider's value, applied to the selection or to every mesh, as Limit to Selected says.
proc hudApplySize(string $slider, string $flag)
{
    if (!`floatSliderGrp -exists $slider`)
        return;
    float $v = `floatSliderGrp -query -value $slider`;
    string $scope = `optionVar -query polyDisplayLimitedToSelectedOV` ? "-activeObjects" : "-global";
    eval("polyOptions " + $scope + " " + $flag + " " + $v);
}

global proc setVertexSize()
{
    hudApplySize("vertexSizeSlider", "-sizeVertex");
}

global proc setUVSize()
{
    hudApplySize("uvSizeSlider", "-sizeUV");
}

global proc setNormalSize()
{
    hudApplySize("normalsSizeSlider", "-sizeNormal");
}

global proc setEdgeWidth()
{
    hudApplySize("edgeSizeSlider", "-sizeBorder");
}

// ---------------------------------------------------------------------------------------------------------------------
// Sections that come and go with a tool.

global proc setWalkModeVisibility(int $state)
{
    if (!`headsUpDisplay -exists HUDWalkMode`)
        return;
    if ($state == 0)
        headsUpDisplay -visible 0 HUDWalkMode;
    else if ($state == 1)
        headsUpDisplay -visible 1 -label "Walk Mode" HUDWalkMode;
    else if ($state == 2)
        headsUpDisplay -visible 1 -label "Walk Mode (Crouch)" HUDWalkMode;
}

global proc setHUDBlendShapeEdit(int $visible, string $name)
{
    // Made together with the sculpt mesh section, so that one's presence says this one is there too.
    if (!`headsUpDisplay -exists HUDActiveSculptMesh`)
        return;
    if ($visible == 0)
        headsUpDisplay -visible 0 HUDBlendShapeEdit;
    else
        headsUpDisplay -visible 1 -label ("Editing blend shape: " + $name) HUDBlendShapeEdit;
}

global proc setHUDActiveSculptMesh(int $visible, string $name)
{
    if (!`headsUpDisplay -exists HUDActiveSculptMesh`)
        return;
    if ($visible == 0)
        headsUpDisplay -visible 0 HUDActiveSculptMesh;
    else
        headsUpDisplay -visible 1 -label ("Sculpting: " + $name) HUDActiveSculptMesh;
}

global proc setHUD3DCutSewUVActiveMesh(int $visible, string $name)
{
    if (!`headsUpDisplay -exists HUD3DCutSewUVActiveMesh`)
        return;
    if ($visible == 0)
        headsUpDisplay -visible 0 HUD3DCutSewUVActiveMesh;
    else
        headsUpDisplay -visible 1 -label ("Cut and sew UVs: " + $name) HUD3DCutSewUVActiveMesh;
}

// So `exists initHUDScripts` says the file is loaded, as the Display menu checks before sourcing it.
global proc initHUDScripts()
{
}
