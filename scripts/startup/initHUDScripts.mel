// initHUDScripts: what the heads-up display's sections show (the procedures their -command flags name), the
// procedures that show or hide each group of sections from Display > Heads Up Display, and the polygon display helpers
// the Display menu and its size windows use. The sections themselves are made elsewhere.
//
// Aztek draws its own sections for poly count, object details, frame rate, current frame, camera names and the view
// axis; those are shown or hidden by name with `headsUpDisplay -vis`. The setters below switch Aztek's own section and
// any scripted section of the reference's name, so scripts that made their own get the same answer.

// The selection mask numbers filterExpand takes, from the globals when something has set them.
proc int hudMaskMeshes()
{
    global int $gSelectMeshesBit;
    return $gSelectMeshesBit ? $gSelectMeshesBit : 12;
}

proc int hudMaskNurbs()
{
    global int $gSelectNurbsSurfacesBit;
    return $gSelectNurbsSurfacesBit ? $gSelectNurbsSurfacesBit : 10;
}

proc int hudMaskSubdivs()
{
    global int $gSelectSubdivSurface;
    return $gSelectSubdivSurface ? $gSelectSubdivSurface : 68;
}

// Shows or hides the named sections that exist, then Aztek's own section standing for them, if it has one.
proc hudShow(string $huds[], string $native, int $visibility)
{
    for ($h in $huds)
        if (`headsUpDisplay -exists $h`)
            headsUpDisplay -visible $visibility $h;
    if ($native != "")
        headsUpDisplay -visible $visibility $native;
}

// The menu item's tick, when the Heads Up Display menu has been built, and the option variable either way.
proc hudRecord(string $item, string $var, int $visibility)
{
    if ($item != "" && `menuItem -exists $item`)
        menuItem -edit -checkBox $visibility $item;
    optionVar -intValue $var $visibility;
}

// A section's text is worked out each time the views draw, so there is nothing to do but redraw them.
proc hudRefresh(string $hud)
{
    if (`headsUpDisplay -exists $hud`)
        refresh;
}

// ---------------------------------------------------------------------------------------------------------------------
// The main object: the last of the selected objects, and whether it is one of the kinds of surface a section reports.

// Whether the lead object is of the kind $items lists: the lead's shape is in it when the lead has other children, or
// the last item is the lead when it hasn't.
proc int hudLeadIsIn(string $items[], string $lead, string $shape, int $hasChildren)
{
    int $n = size($items);
    if ($n == 0)
        return 0;
    if ($hasChildren)
        return stringArrayContains($shape, $items);
    return $items[$n - 1] == $lead;
}

// Whether the lead has children other than its first shape.
proc int hudLeadHasChildren(string $lead, string $shape)
{
    string $kids[] = `listRelatives -children $lead`;
    return size($kids) > 1 || (size($kids) == 1 && $kids[0] != $shape);
}

global proc string objectDetailsBackfaces()
{
    string $objs[] = `ls -selection -objectsOnly`;
    if (size($objs) == 0)
        return "N/A";
    string $lead = $objs[size($objs) - 1];
    string $shapes[] = `listRelatives -shapes $lead`;
    string $shape = size($shapes) ? $shapes[0] : "";
    int $kids = hudLeadHasChildren($lead, $shape);

    string $meshes[] = `filterExpand -selectionMask (hudMaskMeshes()) $objs`;
    string $nurbs[] = `filterExpand -selectionMask (hudMaskNurbs()) $objs`;
    int $valid = hudLeadIsIn($meshes, $lead, $shape, $kids);
    if (size($meshes) && $valid) {
        int $culled[] = `polyOptions -query -backCulling $lead`;
        return (size($culled) && $culled[0]) ? "On" : "Off";
    }
    $valid = $valid || hudLeadIsIn($nurbs, $lead, $shape, $kids);
    if (size($nurbs) && $valid) {
        int $cull[] = `displayCull -query -backFaceCulling $lead`;
        return (size($cull) && $cull[0]) ? "Off" : "On";
    }
    return "N/A";
}

global proc string objectDetailsSmoothness()
{
    string $objs[] = `ls -selection -objectsOnly`;
    if (size($objs) == 0)
        return "N/A";
    string $lead = $objs[size($objs) - 1];
    string $shapes[] = `listRelatives -shapes $lead`;
    string $shape = size($shapes) ? $shapes[0] : "";
    int $kids = hudLeadHasChildren($lead, $shape);

    string $nurbs[] = `filterExpand -expand true -selectionMask (hudMaskNurbs()) $objs`;
    string $subds[] = `filterExpand -expand true -selectionMask (hudMaskSubdivs()) $objs`;
    int $valid = hudLeadIsIn($nurbs, $lead, $shape, $kids);
    if (size($nurbs) && $valid) {
        int $s[] = `displaySmoothness -query -divisionsU -divisionsV -pointsWire -pointsShaded $lead`;
        int $full[] = `displaySmoothness -query -full $lead`;
        int $hull[] = `displaySmoothness -query -hull $lead`;
        if (size($s) < 4)
            return "N/A";
        if (size($hull) && $hull[0])
            return "Hull";
        int $isFull = size($full) && $full[0];
        if ($isFull && $s[0] == 0 && $s[1] == 0 && $s[2] == 4 && $s[3] == 1)
            return "Rough";
        if ($isFull && $s[0] == 1 && $s[1] == 1 && $s[2] == 8 && $s[3] == 2)
            return "Medium";
        if ($isFull && $s[0] == 2 && $s[1] == 2 && $s[2] == 16 && $s[3] == 4)
            return "Fine";
        return "Custom";
    }
    $valid = $valid || hudLeadIsIn($subds, $lead, $shape, $kids);
    if (size($subds) && $valid) {
        // The reference always answers Custom here; this names the level the surface shows, as the NURBS case does.
        if (`exists subdivDisplaySmoothness`) {
            int $level[] = `subdivDisplaySmoothness -query $lead`;
            if (size($level)) {
                if ($level[0] == 0)
                    return "Hull";
                if ($level[0] == 1)
                    return "Rough";
                if ($level[0] == 2)
                    return "Medium";
                if ($level[0] == 3)
                    return "Fine";
            }
        }
        return "Custom";
    }
    return "N/A";
}

global proc string objectDetailsInstance()
{
    string $sel[] = `ls -selection`;
    if (size($sel) == 0)
        return "N/A";
    string $lead = $sel[size($sel) - 1];
    string $shapes[] = `listRelatives -fullPath -shapes $lead`;
    if (size($shapes) == 0)
        return "N/A";
    string $parents[] = `listRelatives -allParents $shapes[0]`;
    return size($parents) > 1 ? "Yes" : "No";
}

global proc string objectDetailsDisplayLayer()
{
    string $objs[] = `ls -selection -objectsOnly`;
    if (size($objs) == 0)
        return "N/A";
    string $lead = $objs[size($objs) - 1];
    if (!`attributeExists drawOverride $lead`)
        return "N/A";
    string $src = `connectionInfo -sourceFromDestination ($lead + ".drawOverride")`;
    string $parts[];
    tokenize $src "." $parts;
    if (size($parts) && `objExists $parts[0]`)
        return $parts[0];
    return "Default";
}

global proc int objectDetailsNumberOfSelectedObjects()
{
    string $objs[] = `ls -selection -objectsOnly`;
    return size($objs);
}

// The particle counts of the given nodes, left out nCloth and nRigid, which are particle nodes too.
proc int hudParticleSum(string $nodes[])
{
    int $sum = 0;
    for ($n in $nodes) {
        string $type = `nodeType $n`;
        if (($type == "particle" || $type == "nParticle") && `attributeExists count $n`)
            $sum += `getAttr ($n + ".count")`;
    }
    return $sum;
}

global proc string getParticleCount()
{
    string $all[] = `ls -type particle`;
    int $total = hudParticleSum($all);
    int $picked = 0;
    string $objs[] = `ls -selection -objectsOnly`;
    for ($o in $objs) {
        string $under[] = `listRelatives -allDescendents -type particle $o`;
        $picked += hudParticleSum($under);
    }
    return ($total + "        " + $picked);
}

// The last selected subdivision surface, or "".
proc string hudLastSubdiv()
{
    string $objs[] = `ls -selection -objectsOnly`;
    if (size($objs) == 0)
        return "";
    string $subds[] = `filterExpand -expand true -selectionMask (hudMaskSubdivs()) $objs`;
    return size($subds) ? $subds[size($subds) - 1] : "";
}

global proc string subdDetailsCurrentLevel()
{
    string $s = hudLastSubdiv();
    if ($s != "" && `exists subdiv`) {
        int $proxy = `subdiv -query -proxyMode $s`;
        if ($proxy != 1) {
            int $level = `subdiv -query -currentSubdLevel $s`;
            return ("" + $level);
        }
    }
    return "N/A";
}

global proc string subdDetailsCurrentMode()
{
    string $s = hudLastSubdiv();
    if ($s == "")
        return "N/A";
    if (`exists subdiv` && `subdiv -query -proxyMode $s` == 1)
        return "Polygon Proxy";
    return "Standard";
}

