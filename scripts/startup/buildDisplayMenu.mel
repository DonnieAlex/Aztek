// A smoothness item: dragging it runs $drag, and its option box runs the options command.
proc bdmSmoothItem(string $item, string $rtc, string $drag, string $optItem, string $optRtc, string $ann)
{
    string $label = bdmWords($rtc);
    menuItem -label $label -annotation $label -command $rtc -dragMenuCommand $drag $item;
    menuItem -optionBox true -annotation $ann -command $optRtc $optItem;
}

