global proc doPerCameraVisibility(int $action)
{
    if (!`exists perCameraVisibility`) {
        warning "Per camera visibility isn't available.";
        return;
    }
    if ($action == 5) {
        evalEcho "perCameraVisibility -removeAll";
        return;
    }
    string $cameras[];
    string $others = "";
    string $picked[] = `ls -selection`;
    for ($s in $picked) {
        if (!catchQuiet(`camera -query -aspectRatio $s`))
            $cameras[size($cameras)] = $s;
        else
            $others += " " + $s;
    }
    if (size($cameras) == 0) {
        if (!`exists getSequencerViewCamera`)
            catchQuiet(`eval "source \"sequenceEditorPanel.mel\""`);
        if (`exists getSequencerViewCamera`)
            $cameras[0] = eval("getSequencerViewCamera");
    }
    for ($c in $cameras) {
        if ($c == "")
            continue;
        string $cmd = "perCameraVisibility -c " + $c;
        if ($action == 0)
            $cmd += " -exclusive" + $others;
        else if ($action == 1)
            $cmd += " -hide" + $others;
        else if ($action == 2)
            $cmd += " -exclusive -remove" + $others;
        else if ($action == 3)
            $cmd += " -hide -remove" + $others;
        else if ($action == 4)
            $cmd += " -removeCamera";
        evalEcho $cmd;
    }
}

global proc buildPerCameraVisibilitySubmenu(string $parent)
{
    setParent -menu $parent;
    bdmItem("exclusiveToCameraItem", "SetExclusiveToCamera");
