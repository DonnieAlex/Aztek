    bdmItem("removeAllItem", "CameraRemoveAllForAll");
    menuItem -edit -postMenuCommand "" $parent;
}

global proc polyNonPlanarFaceDisplay()
{
    int $warp[] = `polyOptions -query -displayWarp`;
    if (size($warp) && $warp[0])
        polyOptions -activeObjects -displayWarp 0;
    else
        polyOptions -activeObjects -displayWarp 1;
}

// ---------------------------------------------------------------------------------------------------------------------
// Metadata display. Aztek has no metadata streams yet, so these keep their option variable and do nothing more when
// the commands for it aren't there.

// "stream.member.dataType" split in three.
proc string[] bdmStreamMember()
{
    string $parts[];
    if (!`exists getCurrentStreamMember`)
        catchQuiet(`eval "source \"performVisualizeMetadataOptions.mel\""`);
    if (`exists getCurrentStreamMember`) {
        string $sm = eval("getCurrentStreamMember");
        tokenize $sm "." $parts;
    }
    return $parts;
}

global proc resetMetadataMenuOptions()
{
    optionVar -stringValue metadataVisualCurrentStreamMember "";
    updateMetadataVisualMenu();
}

global proc updateMetadataVisualMenu()
{
    global string $gMetadataVisualCheckBox;
    string $p[] = bdmStreamMember();
    if (size($p) < 3 || !`exists showMetadata` || $gMetadataVisualCheckBox == "" || !`menuItem -exists $gMetadataVisualCheckBox`)
        return;
    int $on = eval("showMetadata -query -isActivated -stream \"" + $p[0] + "\" -member \"" + $p[1] + "\" -dataType \"" + $p[2] + "\"");
    menuItem -edit -checkBox $on $gMetadataVisualCheckBox;
}

// Runs a procedure from another file, sourcing it when it isn't loaded.
proc bdmCallFrom(string $proc, string $file)
{
    if (!`exists $proc`)
        catchQuiet(`eval ("source \"" + $file + "\"")`);
    if (`exists $proc`)
        eval($proc);
}

global proc updateMetadataUI()
{
    updateMetadataVisualMenu();
    bdmCallFrom("updateMetadataOptionBox", "performVisualizeMetadataOptions.mel");
    bdmCallFrom("updateEditMetadataWindow", "editMetadataWindow.mel");
}

global proc resetMetadataUI()
{
    resetMetadataMenuOptions();
    bdmCallFrom("resetMetadataOptionBox", "performVisualizeMetadataOptions.mel");
    bdmCallFrom("resetEditMetadataWindow", "editMetadataWindow.mel");
}

global proc toggleMetadata()
{
    global string $gMetadataVisualCheckBox;
    if ($gMetadataVisualCheckBox == "" || !`menuItem -exists $gMetadataVisualCheckBox` || !`exists showMetadata`)
        return;
    int $on = `menuItem -query -checkBox $gMetadataVisualCheckBox`;
    string $p[] = bdmStreamMember();
    if (size($p) < 3)
        return;
    string $shapes[] = `ls -shapes`;
    string $cmd = "showMetadata -stream \"" + $p[0] + "\" -member \"" + $p[1] + "\" -dataType \"" + $p[2] + "\"";
    if (!$on)
        $cmd += " -off";
    for ($s in $shapes)
        $cmd += " \"" + $s + "\"";
    eval($cmd);
}

