        -command "displayPref -displayAffected `menuItem -query -checkBox highlightAffectedMenuItem`" highlightAffectedMenuItem;
    // Kept in step when the preference changes elsewhere, for as long as the menu is there.
    scriptJob -permanent -parent $parent -event DisplayPreferenceChanged
