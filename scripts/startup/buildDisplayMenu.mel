    menuItem -edit -postMenuCommand "" $parent;
}

// ---------------------------------------------------------------------------------------------------------------------
// The small windows that size vertices, UVs, normals and edges.

global proc winReset(string $op)
{
    if ($op == "VertSz") {
        if (`floatSliderGrp -exists vertexSizeSlider`)
            floatSliderGrp -edit -value 3.0 vertexSizeSlider;
        polyOptions -sizeVertex 3.0;
    } else if ($op == "UVSz") {
        if (`floatSliderGrp -exists uvSizeSlider`)
            floatSliderGrp -edit -value 4.0 uvSizeSlider;
        polyOptions -sizeUV 4.0;
    } else if ($op == "NormSz") {
        if (`floatSliderGrp -exists normalsSizeSlider`)
            floatSliderGrp -edit -value 0.4 normalsSizeSlider;
        polyOptions -sizeNormal 0.4;
    } else if ($op == "EdgeSz") {
        if (`floatSliderGrp -exists edgeSizeSlider`)
            floatSliderGrp -edit -value 2.0 edgeSizeSlider;
        polyOptions -sizeBorder 2.0;
    }
}

global proc dispWindow(string $op)
{
    string $win = $op + "wnd";
    if (`window -exists $win`) {
        showWindow $win;
        return;
    }
    string $title = "Size";
    string $slider = "";
    float $value = 1.0;
    string $change = "";
    if ($op == "VertSz") {
        $title = "Vertex Size";
        $slider = "vertexSizeSlider";
        $value = 3.0;
        $change = "setVertexSize()";
    } else if ($op == "UVSz") {
        $title = "UV Size";
        $slider = "uvSizeSlider";
        $value = 4.0;
        $change = "setUVSize()";
    } else if ($op == "NormSz") {
        $title = "Normal Size";
        $slider = "normalsSizeSlider";
        $value = 0.4;
        $change = "setNormalSize()";
    } else if ($op == "EdgeSz") {
        $title = "Edge Width";
        $slider = "edgeSizeSlider";
        $value = 2.0;
        $change = "setEdgeWidth()";
    }
    // The setters are in initHUDScripts.
    if (!`exists setVertexSize`)
        catchQuiet(`eval "source \"initHUDScripts.mel\""`);

    window -resizeToFitChildren true -iconName $op -menuBar true -widthHeight 250 75 -sizeable false -title $title $win;
    menu -label "Reset" -familyImage "menuIconReset.png" ($op + "ResetMenu");
    menuItem -label "Reset Settings" -command ("winReset " + $op) ($op + "ResetToItem");
    string $form = `formLayout`;
    if ($slider != "") {
        if ($op == "NormSz")
            floatSliderGrp -field true -minValue 0.02 -maxValue 10 -fieldMaxValue 10000 -precision 2 -value $value -changeCommand $change $slider;
        else
            floatSliderGrp -field true -minValue 0.02 -maxValue 10 -precision 2 -value $value -changeCommand $change $slider;
        formLayout -edit -attachForm $slider "top" 3 -attachForm $slider "left" 3 -attachForm $slider "right" 3 -attachForm $slider "bottom" 3 $form;
    }
    showWindow $win;
}
